<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette reprise de l'enseigne : noir profond et or, comme le blason du
        magasin. Le noir habille le menu et les en-têtes, l'or signale ce qui
        compte — écran actif, total à encaisser, action principale.

        La zone de travail reste claire : un caissier la regarde huit heures
        par jour, et du texte sombre sur fond clair s'y lit sans fatigue.
    -->

    <!-- Noirs de l'enseigne -->
    <Color x:Key="CouleurPrincipale">#121212</Color>
    <Color x:Key="CouleurPrincipaleClaire">#242424</Color>
    <Color x:Key="CouleurPrincipaleFoncee">#000000</Color>

    <!-- Or de l'enseigne -->
    <Color x:Key="CouleurAccent">#C9A227</Color>
    <Color x:Key="CouleurOr">#C9A227</Color>
    <Color x:Key="CouleurOrClair">#E3C76F</Color>
    <Color x:Key="CouleurOrFonce">#8F7318</Color>

    <Color x:Key="CouleurSucces">#1E7E34</Color>
    <Color x:Key="CouleurAvertissement">#B0791C</Color>
    <Color x:Key="CouleurDanger">#C0392B</Color>
    <Color x:Key="CouleurInfo">#2C7BE5</Color>

    <!-- Fonds légèrement chauds : l'or y paraît juste, un gris bleuté le ternirait -->
    <Color x:Key="CouleurFond">#F5F3EF</Color>
    <Color x:Key="CouleurSurface">#FFFFFF</Color>
    <Color x:Key="CouleurSurfaceAlterne">#FAF8F3</Color>
    <Color x:Key="CouleurBordure">#E4E0D6</Color>
    <Color x:Key="CouleurBordureForte">#CEC8B9</Color>

    <Color x:Key="CouleurTexte">#171612</Color>
    <Color x:Key="CouleurTexteSecondaire">#5D584B</Color>
    <Color x:Key="CouleurTexteAttenue">#8E887A</Color>
    <Color x:Key="CouleurTexteSurPrincipale">#FFFFFF</Color>

    <SolidColorBrush x:Key="PinceauPrincipal" Color="{StaticResource CouleurPrincipale}" />
    <SolidColorBrush x:Key="PinceauPrincipalClair" Color="{StaticResource CouleurPrincipaleClaire}" />
    <SolidColorBrush x:Key="PinceauPrincipalFonce" Color="{StaticResource CouleurPrincipaleFoncee}" />
    <SolidColorBrush x:Key="PinceauAccent" Color="{StaticResource CouleurAccent}" />

    <SolidColorBrush x:Key="PinceauOr" Color="{StaticResource CouleurOr}" />
    <SolidColorBrush x:Key="PinceauOrClair" Color="{StaticResource CouleurOrClair}" />
    <SolidColorBrush x:Key="PinceauOrFonce" Color="{StaticResource CouleurOrFonce}" />

    <!-- Or dégradé, réservé aux éléments d'identité : blason et titre -->
    <LinearGradientBrush x:Key="PinceauOrPoli" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8F7318" Offset="0" />
        <GradientStop Color="#E3C76F" Offset="0.45" />
        <GradientStop Color="#C9A227" Offset="0.75" />
        <GradientStop Color="#8F7318" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PinceauSucces" Color="{StaticResource CouleurSucces}" />
    <SolidColorBrush x:Key="PinceauAvertissement" Color="{StaticResource CouleurAvertissement}" />
    <SolidColorBrush x:Key="PinceauDanger" Color="{StaticResource CouleurDanger}" />
    <SolidColorBrush x:Key="PinceauInfo" Color="{StaticResource CouleurInfo}" />

    <SolidColorBrush x:Key="PinceauFond" Color="{StaticResource CouleurFond}" />
    <SolidColorBrush x:Key="PinceauSurface" Color="{StaticResource CouleurSurface}" />
    <SolidColorBrush x:Key="PinceauSurfaceAlterne" Color="{StaticResource CouleurSurfaceAlterne}" />
    <SolidColorBrush x:Key="PinceauBordure" Color="{StaticResource CouleurBordure}" />
    <SolidColorBrush x:Key="PinceauBordureForte" Color="{StaticResource CouleurBordureForte}" />

    <SolidColorBrush x:Key="PinceauTexte" Color="{StaticResource CouleurTexte}" />
    <SolidColorBrush x:Key="PinceauTexteSecondaire" Color="{StaticResource CouleurTexteSecondaire}" />
    <SolidColorBrush x:Key="PinceauTexteAttenue" Color="{StaticResource CouleurTexteAttenue}" />
    <SolidColorBrush x:Key="PinceauTexteSurPrincipale" Color="{StaticResource CouleurTexteSurPrincipale}" />

    <!-- Fonds atténués employés pour les pastilles d'état -->
    <SolidColorBrush x:Key="PinceauFondSucces" Color="#E6F4EA" />
    <SolidColorBrush x:Key="PinceauFondAvertissement" Color="#FBF2DF" />
    <SolidColorBrush x:Key="PinceauFondDanger" Color="#FBEAE8" />
    <SolidColorBrush x:Key="PinceauFondInfo" Color="#E8F1FD" />
    <SolidColorBrush x:Key="PinceauFondOr" Color="#FBF4DF" />

</ResourceDictionary>
