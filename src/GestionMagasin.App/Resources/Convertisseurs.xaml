<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:GestionMagasin.App.Converters">

    <!--
        Convertisseurs d'affichage.

        Ils sont déclarés dans ce dictionnaire, et non directement dans
        App.xaml, pour être fusionnés AVANT les styles. Un « StaticResource »
        écrit à l'intérieur d'un style ne voit que les dictionnaires fusionnés
        avant le sien : le style « ChampListeEnum » ne pourrait pas atteindre
        un convertisseur déclaré ailleurs, et l'écran concerné échouerait à
        s'afficher.
    -->

    <conv:ConvertisseurMontant x:Key="Montant" />
    <conv:ConvertisseurDate x:Key="Date" />
    <conv:ConvertisseurBooleenVisibilite x:Key="BooleenVisibilite" />
    <conv:ConvertisseurBooleenInverse x:Key="BooleenInverse" />
    <conv:ConvertisseurNonVideVisibilite x:Key="NonVideVisibilite" />
    <conv:ConvertisseurCouleurEtat x:Key="CouleurEtat" />
    <conv:ConvertisseurCodeCouleur x:Key="CodeCouleur" />
    <conv:ConvertisseurProportion x:Key="Proportion" />
    <conv:ConvertisseurEgalite x:Key="Egalite" />
    <conv:ConvertisseurLibelleEnum x:Key="LibelleEnum" />
    <conv:ConvertisseurGeometrie x:Key="Icone" />

</ResourceDictionary>
