<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GestionMagasin.App</RootNamespace>
    <AssemblyName>GestionMagasin</AssemblyName>
    <!--
      Icône du programme : le lion couronné de l'enseigne, aux sept tailles
      que Windows réclame. Sans elle, chaque barre de titre et la barre des
      tâches affichaient l'icône par défaut de WPF, crénelée.
      Les fenêtres WPF la reprennent d'elles-mêmes : aucune n'a besoin de
      fixer sa propre Icon.
    -->
    <!--
      Le logo du magasin l'emporte lorsqu'il a été converti par le script de
      publication ; l'emblème dessiné sert de recours. « logo.ico » n'est pas
      versionné : il appartient au magasin, pas au logiciel.
    -->
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\logo.ico')">logo.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">vipmensstore.ico</ApplicationIcon>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!--
      Manifeste Windows. Il déclare surtout la conscience du zoom
      d'affichage : sans elle, Windows étire l'image du logiciel au lieu de
      le laisser se redessiner, et tout paraît flou sur un écran réglé à
      125 ou 150 %.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Horodatage de compilation, ajouté au numéro de version. Le menu
      l'affiche : c'est le seul repère qui distingue une livraison de la
      précédente, le numéro restant à 1.0.0 entre deux.
    -->
    <SourceRevisionId>$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmm"))</SourceRevisionId>
    <!-- Nom vu par Windows : barre des tâches, propriétés du fichier, gestionnaire des tâches. -->
    <Product>VIP MEN’S STORE</Product>
    <AssemblyTitle>VIP MEN’S STORE</AssemblyTitle>
    <Company>VIP MEN’S STORE — Béjaïa</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionMagasin.Domain\GestionMagasin.Domain.csproj" />
    <ProjectReference Include="..\GestionMagasin.Application\GestionMagasin.Application.csproj" />
    <ProjectReference Include="..\GestionMagasin.Infrastructure\GestionMagasin.Infrastructure.csproj" />
    <ProjectReference Include="..\GestionMagasin.ServeurEmbarque\GestionMagasin.ServeurEmbarque.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
