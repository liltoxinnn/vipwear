<Application x:Class="GestionMagasin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                L'ordre de fusion est significatif : chaque dictionnaire ne
                peut utiliser que les ressources des dictionnaires fusionnés
                avant lui. Les couleurs servent aux styles, les convertisseurs
                sont employés à l'intérieur de certains styles, et les modèles
                de vues utilisent les deux.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Couleurs.xaml" />
                <ResourceDictionary Source="Resources/Convertisseurs.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/ModelesVues.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
