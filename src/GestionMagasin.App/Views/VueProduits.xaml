<UserControl x:Class="GestionMagasin.App.Views.VueProduits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Barre de filtres ============ -->
        <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ChampTexte}"
                             Width="260"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SurToucheRecherche"
                             ToolTip="Nom, référence, code article ou code-barres" />

                    <ComboBox Style="{StaticResource ChampListe}"
                              Width="170" Margin="8,0,0,0"
                              ItemsSource="{Binding Familles}"
                              SelectedItem="{Binding FamilleFiltre}"
                              DisplayMemberPath="Nom"
                              ToolTip="Filtrer par famille : chemises, pantalons, chaussures…" />

                    <ComboBox Style="{StaticResource ChampListe}"
                              Width="150" Margin="8,0,0,0"
                              ItemsSource="{Binding Marques}"
                              SelectedItem="{Binding MarqueFiltre}"
                              DisplayMemberPath="Nom"
                              ToolTip="Filtrer par marque" />

                    <CheckBox Style="{StaticResource CaseACocher}"
                              Content="Afficher les produits inactifs"
                              IsChecked="{Binding InclureInactifs}"
                              Margin="14,0,0,0" />

                    <Button Content="Rechercher"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding RechercherCommand}"
                            Margin="12,0,0,0" />

                    <Button Content="Réinitialiser"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ReinitialiserFiltresCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Exporter"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ExporterCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Exporter le catalogue vers un classeur Excel" />

                    <Button Content="Nouveau produit"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding NouveauProduitCommand}"
                            IsEnabled="{Binding PeutModifier}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Liste et fiche ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des produits -->
            <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10">
                        <Run Text="Produits (" /><Run Text="{Binding Produits.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Produits}"
                              SelectedItem="{Binding ProduitSelectionne}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="120" />
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                            <DataGridTextColumn Header="Famille" Binding="{Binding Categorie}" Width="140" />
                            <DataGridTextColumn Header="Marque" Binding="{Binding Marque}" Width="110" />
                            <DataGridTextColumn Header="Prix de vente"
                                                Binding="{Binding PrixVente, Converter={StaticResource Montant}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Décl." Binding="{Binding NombreVariantes}" Width="60" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockTotal}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Fiche produit et déclinaisons -->
            <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Aucun produit sélectionné -->
                    <TextBlock Grid.Row="0"
                               Text="Sélectionnez un produit dans la liste pour afficher sa fiche."
                               Style="{StaticResource TexteAttenue}"
                               Visibility="{Binding Fiche, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}" />

                    <!-- En-tête de la fiche -->
                    <StackPanel Grid.Row="0"
                                Visibility="{Binding Fiche, Converter={StaticResource NonVideVisibilite}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Fiche.Nom}" Style="{StaticResource TexteSousTitre}" />
                                <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                    <Run Text="Réf." /><Run Text="{Binding Fiche.Reference, Mode=OneWay}" />
                                    <Run Text="  •  Code article " /><Run Text="{Binding Fiche.Sku, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Pastille}">
                                        <Setter Property="Background" Value="{StaticResource PinceauFondSucces}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Fiche.Actif}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource PinceauFondDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextePastille}">
                                            <Setter Property="Text" Value="Actif" />
                                            <Setter Property="Foreground" Value="{StaticResource PinceauSucces}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fiche.Actif}" Value="False">
                                                    <Setter Property="Text" Value="Inactif" />
                                                    <Setter Property="Foreground" Value="{StaticResource PinceauDanger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Informations principales -->
                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Prix d'achat" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.PrixAchat, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Prix de vente" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.PrixVente, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PinceauPrincipal}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Marge" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.Marge, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PinceauSucces}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Stock total" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.StockTotal}" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Marque" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.Marque}" Style="{StaticResource TexteSecondaire}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Collection" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.Collection}" Style="{StaticResource TexteSecondaire}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Saison" Style="{StaticResource TexteEtiquette}" />
                                <TextBlock Text="{Binding Fiche.Saison}" Style="{StaticResource TexteSecondaire}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12"
                                Visibility="{Binding Fiche, Converter={StaticResource NonVideVisibilite}}">
                        <Button Content="Modifier le produit"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ModifierProduitCommand}"
                                IsEnabled="{Binding PeutModifier}"
                                Margin="0,0,8,0" />

                        <Button Content="Activer / Désactiver"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding BasculerEtatProduitCommand}"
                                IsEnabled="{Binding PeutDesactiver}"
                                Margin="0,0,8,0" />

                        <Button Content="Ajouter une déclinaison"
                                Style="{StaticResource BoutonPrincipal}"
                                Command="{Binding NouvelleVarianteCommand}"
                                IsEnabled="{Binding PeutModifier}"
                                Margin="0,0,8,0" />

                        <Button Content="Générer les déclinaisons"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding GenererVariantesCommand}"
                                IsEnabled="{Binding PeutModifier}"
                                ToolTip="Créer d'un coup toutes les combinaisons de tailles et de couleurs" />
                    </StackPanel>

                    <!-- Tableau des déclinaisons -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding Fiche, Converter={StaticResource NonVideVisibilite}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Déclinaisons"
                                   Style="{StaticResource TexteSousTitre}" Margin="0,0,0,8" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Fiche.Variantes}"
                                  SelectedItem="{Binding VarianteSelectionnee}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Couleur" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3"
                                                        BorderBrush="{StaticResource PinceauBordureForte}"
                                                        BorderThickness="1"
                                                        Background="{Binding CodeCouleur, Converter={StaticResource CodeCouleur}}"
                                                        VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Couleur}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="80" />
                                <DataGridTextColumn Header="Code article" Binding="{Binding Sku}" Width="*" />
                                <DataGridTextColumn Header="Code-barres" Binding="{Binding CodeBarres}" Width="140" />
                                <DataGridTextColumn Header="Prix de vente"
                                                    Binding="{Binding PrixVente, Converter={StaticResource Montant}}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding QuantiteDisponible}" Width="70" />
                                <DataGridTextColumn Header="Seuil" Binding="{Binding SeuilMinimum}" Width="65" />

                                <DataGridTemplateColumn Header="Situation" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pastille}"
                                                    Background="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                                <TextBlock Text="{Binding LibelleEtat}"
                                                           Style="{StaticResource TextePastille}"
                                                           Foreground="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Modifier la déclinaison"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding ModifierVarianteCommand}"
                                    IsEnabled="{Binding PeutModifier}"
                                    Margin="0,0,8,0" />

                            <Button Content="Activer / Désactiver la déclinaison"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatVarianteCommand}"
                                    IsEnabled="{Binding PeutModifier}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
