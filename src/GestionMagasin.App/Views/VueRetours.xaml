<UserControl x:Class="GestionMagasin.App.Views.VueRetours"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- ============ Historique des retours ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBox Style="{StaticResource ChampTexte}"
                             Width="200"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SurToucheRecherche"
                             ToolTip="Numéro de retour ou numéro de vente" />

                    <TextBlock Text="Du" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateDebut}" />

                    <TextBlock Text="au" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="8,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateFin}" />

                    <Button Content="Rechercher"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding RechercherCommand}"
                            Margin="10,0,0,0" />

                    <Button Content="Exporter"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ExporterCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Style="{StaticResource TexteSousTitre}">
                            <Run Text="{Binding Retours.Count, Mode=OneWay}" /><Run Text=" retour(s)" />
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="Total remboursé : " Foreground="#5A6577" />
                            <Run Text="{Binding TotalRembourse, Converter={StaticResource Montant}, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="#C0392B" />
                        </TextBlock>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Retours}"
                              SelectedItem="{Binding RetourSelectionne}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° de retour" Binding="{Binding NumeroRetour}" Width="140" />
                            <DataGridTextColumn Header="Vente" Binding="{Binding NumeroVente}" Width="140" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateRetour, Converter={StaticResource Date}, ConverterParameter=heure}"
                                                Width="140" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientNom}" Width="*" />
                            <DataGridTextColumn Header="Art." Binding="{Binding NombreArticles}" Width="60" />
                            <DataGridTextColumn Header="Remboursé"
                                                Binding="{Binding TotalRembourse, Converter={StaticResource Montant}}"
                                                Width="130" />
                            <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Imprimer le bon de retour"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ImprimerBonSelectionneCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Détail du retour sélectionné -->
            <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TexteEtiquette}">
                        <Run Text="Détail du retour " /><Run Text="{Binding Detail.NumeroRetour, Mode=OneWay}" />
                    </TextBlock>

                    <DataGrid ItemsSource="{Binding Detail.Lignes}"
                              Style="{StaticResource Tableau}"
                              MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*" />
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="60" />
                            <DataGridTemplateColumn Header="État" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pastille}"
                                                Background="{Binding LibelleEtatArticle, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                            <TextBlock Text="{Binding LibelleEtatArticle}"
                                                       Style="{StaticResource TextePastille}"
                                                       Foreground="{Binding LibelleEtatArticle, Converter={StaticResource CouleurEtat}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Remis en stock" Binding="{Binding RemisEnStock}" Width="120" />
                            <DataGridTextColumn Header="Remboursé"
                                                Binding="{Binding MontantRembourse, Converter={StaticResource Montant}}"
                                                Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Saisie d'un retour ============ -->
        <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Nouveau retour" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,12" />

                    <TextBlock Text="Numéro de la vente figurant sur le ticket"
                               Style="{StaticResource TexteEtiquette}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding NumeroVenteRecherche, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheNumeroVente" />

                        <Button Grid.Column="1"
                                Content="Chercher"
                                Style="{StaticResource BoutonPrincipal}"
                                Command="{Binding ChercherVenteCommand}"
                                Height="48" Width="110"
                                Margin="8,0,0,0" />
                    </Grid>

                    <Border Background="{StaticResource PinceauFondInfo}"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding VenteOrigine, Converter={StaticResource NonVideVisibilite}}">
                        <StackPanel>
                            <TextBlock Text="{Binding VenteOrigine.NumeroVente}" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                <Run Text="Vendue le " />
                                <Run Text="{Binding VenteOrigine.DateVente, Converter={StaticResource Date}, Mode=OneWay}" />
                                <Run Text=" • Total " />
                                <Run Text="{Binding VenteOrigine.Total, Converter={StaticResource Montant}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Articles à reprendre -->
                <Grid Grid.Row="1"
                      Visibility="{Binding VenteOrigine, Converter={StaticResource NonVideVisibilite}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Articles rapportés par le client"
                               Style="{StaticResource TexteEtiquette}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ArticlesRetournables}"
                              Style="{StaticResource Tableau}"
                              IsReadOnly="False"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding Selectionnee, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Article" Binding="{Binding Designation}"
                                                Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Max" Binding="{Binding QuantiteRetournable}"
                                                Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qté"
                                                Binding="{Binding QuantiteARetourner, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60" />
                            <DataGridComboBoxColumn Header="État" Width="120"
                                                    SelectedItemBinding="{Binding EtatArticle, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.EtatsArticle,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.EtatsArticle,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Validation -->
                <StackPanel Grid.Row="2"
                            Visibility="{Binding VenteOrigine, Converter={StaticResource NonVideVisibilite}}">
                    <TextBlock Text="Motif du retour" Style="{StaticResource TexteEtiquette}" Margin="0,12,0,0" />
                    <TextBox Style="{StaticResource ChampTexte}"
                             Text="{Binding MotifRetour}"
                             Margin="0,0,0,12" />

                    <Border Background="{StaticResource PinceauFondAvertissement}"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Montant à rembourser" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MontantARembourser, Converter={StaticResource Montant}}"
                                       FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Un article endommagé est repris et remboursé, mais il ne réintègre pas le stock."
                               Style="{StaticResource TexteAttenue}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Annuler"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding AnnulerSaisieCommand}"
                                Width="110" Margin="0,0,8,0" />

                        <Button Grid.Column="1"
                                Content="VALIDER LE RETOUR"
                                Style="{StaticResource BoutonCaisse}"
                                Command="{Binding ValiderRetourCommand}" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Saisissez le numéro de vente figurant sur le ticket du client pour commencer un retour."
                           Style="{StaticResource TexteAttenue}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding VenteOrigine, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
