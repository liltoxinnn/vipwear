<UserControl x:Class="GestionMagasin.App.Views.VueParametres"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TabControl Margin="20,16" Background="Transparent" BorderThickness="0">

        <!-- ============ Fiche du magasin ============ -->
        <TabItem Header="Informations du magasin">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Identité du magasin"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                            <TextBlock Text="Nom du magasin *" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding NomMagasin}" Margin="0,0,0,12" />

                            <TextBlock Text="Adresse" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Adresse}"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Téléphone" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Telephone}" Margin="0,0,0,12" />

                            <TextBlock Text="Adresse e-mail" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Email}" Margin="0,0,0,12" />

                            <TextBlock Text="Message imprimé en bas des tickets"
                                       Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding InformationsTicket}"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Lien du QR code imprimé en bas des tickets"
                                       Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding LienQrCodeTicket}"
                                     ToolTip="Le QR code est fabriqué à partir de ce lien : collez-le tel quel" />
                            <TextBlock Style="{StaticResource TexteAttenue}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Votre page Instagram, Facebook ou Linktree, par exemple https://linktr.ee/VIPMENSSTORE. Laissez vide pour ne pas imprimer de QR code." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Mentions légales et réglages"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,4" />

                            <TextBlock Text="Imprimées sur les factures, pas sur les tickets."
                                       Style="{StaticResource TexteAttenue}" Margin="0,0,0,14" />

                            <TextBlock Text="Registre du commerce" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding RegistreCommerce}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Numéro d'identification fiscale (NIF)"
                                       Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}"
                                     Text="{Binding NumeroIdentificationFiscale}" Margin="0,0,0,12" />

                            <TextBlock Text="Article d'imposition" Style="{StaticResource TexteEtiquette}" />
                            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding ArticleImposition}"
                                     Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Devise *" Style="{StaticResource TexteEtiquette}" />
                                    <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Devise}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Symbole affiché *" Style="{StaticResource TexteEtiquette}" />
                                    <TextBox Style="{StaticResource ChampTexte}" Text="{Binding SymboleDevise}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Taux de TVA (%)" Style="{StaticResource TexteEtiquette}" />
                                    <TextBox Style="{StaticResource ChampTexte}"
                                             Text="{Binding TauxTva, StringFormat={}{0:N2}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Délai de retour (jours)" Style="{StaticResource TexteEtiquette}" />
                                    <TextBox Style="{StaticResource ChampTexte}" Text="{Binding DelaiRetourJours}"
                                             ToolTip="Mettre 0 pour accepter les retours sans limite de temps" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Enregistrer les paramètres"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding EnregistrerCommand}"
                                    HorizontalAlignment="Right" />

                            <!--
                                Logo du magasin. L'aperçu est le gabarit employé
                                par l'écran de connexion : ce qui s'affiche ici
                                est exactement ce que verra l'utilisateur.
                            -->
                            <StackPanel Margin="0,26,0,0">

                                <Separator Margin="0,0,0,18" />

                                <TextBlock Text="Logo du magasin"
                                           Style="{StaticResource TexteSousTitre}"
                                           Margin="0,0,0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl Grid.Column="0"
                                                    Width="104" Height="104"
                                                    VerticalAlignment="Top"
                                                    Template="{StaticResource BlasonComplet}" />

                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Style="{StaticResource TexteSecondaire}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10">
                                            L'emblème ci-contre est dessiné dans le logiciel : il
                                            s'affiche sur l'écran de connexion et dans le menu sans
                                            qu'aucun fichier soit nécessaire.
                                        </TextBlock>

                                        <TextBlock Style="{StaticResource TexteSecondaire}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14">
                                            Pour afficher votre propre logo à la place, choisissez
                                            l'image ci-dessous. Une image carrée donne le meilleur
                                            résultat. Le changement est immédiat.
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Choisir une image…"
                                                    Style="{StaticResource BoutonPrincipal}"
                                                    Command="{Binding ChoisirLogoCommand}"
                                                    Margin="0,0,10,0" />

                                            <Button Content="Retirer le logo"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Command="{Binding RetirerLogoCommand}"
                                                    ToolTip="Revenir à l'emblème dessiné dans le logiciel"
                                                    Visibility="{Binding Enseigne.LogoInstalle,
                                                                 Converter={StaticResource BooleenVisibilite}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--
                                Sauvegarde des données. Cette section n'apparaît
                                que lorsque le logiciel héberge lui-même sa base :
                                elle est alors la seule protection du magasin.
                            -->
                            <StackPanel Margin="0,26,0,0"
                                        Visibility="{Binding SauvegardeDisponible,
                                                     Converter={StaticResource BooleenVisibilite}}">

                                <Separator Margin="0,0,0,18" />

                                <TextBlock Text="Sauvegarde des données"
                                           Style="{StaticResource TexteSousTitre}"
                                           Margin="0,0,0,6" />

                                <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,14">
                                    Toutes les données de votre magasin — ventes, stock, clients —
                                    vivent sur cet ordinateur. Une sauvegarde régulière est votre
                                    seule protection en cas de panne ou de vol.
                                </TextBlock>

                                <Border Background="{StaticResource PinceauFondAvertissement}"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="12.5"
                                               Foreground="{StaticResource PinceauAvertissement}">
                                        Faites une sauvegarde au moins une fois par semaine, et
                                        conservez le fichier ailleurs que sur cet ordinateur :
                                        clé USB, disque externe ou espace en ligne.
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding MessageSauvegarde}"
                                           Style="{StaticResource TexteAttenue}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding MessageSauvegarde,
                                                        Converter={StaticResource NonVideVisibilite}}" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Restaurer une sauvegarde"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Command="{Binding RestaurerCommand}"
                                            Margin="0,0,10,0"
                                            ToolTip="Remplace toutes les données actuelles par celles du fichier choisi" />

                                    <Button Content="Sauvegarder maintenant"
                                            Style="{StaticResource BoutonPrincipal}"
                                            Command="{Binding SauvegarderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ============ Données de référence ============ -->
        <TabItem Header="Familles, marques, tailles et couleurs">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Familles d'articles. Chacune impose son système de tailles :
                    c'est ce qui empêche de créer une chaussure en XXL.
                -->
                <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Familles d'articles"
                                   Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Familles}"
                                  SelectedItem="{Binding FamilleSelectionnee}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                                <DataGridTextColumn Header="Tailles employées"
                                                    Binding="{Binding SystemeTaille}" Width="190" />
                                <DataGridTextColumn Header="Articles" Binding="{Binding NombreProduits}" Width="75" />
                                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Ajouter"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouvelleFamilleCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Activer / Désactiver"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatFamilleCommand}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Marques -->
                <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Marques"
                                   Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Marques}"
                                  SelectedItem="{Binding MarqueSelectionnee}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                                <DataGridTextColumn Header="Produits" Binding="{Binding NombreUtilisations}" Width="80" />
                                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Ajouter"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouvelleMarqueCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Renommer"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding RenommerMarqueCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Activer / Désactiver"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatMarqueCommand}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Tailles -->
                <Border Grid.Column="4" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4,0,0,10">
                            <TextBlock Text="Tailles" Style="{StaticResource TexteSousTitre}" />

                            <ComboBox Style="{StaticResource ChampListe}"
                                      Margin="0,8,0,0"
                                      ItemsSource="{Binding SystemesTailles}"
                                      SelectedItem="{Binding SystemeTailleChoisi}"
                                      DisplayMemberPath="Nom"
                                      ToolTip="Les tailles sont cloisonnées par système : « 42 » n'est pas la même chose en pointure et en taille de pantalon" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Tailles}"
                                  SelectedItem="{Binding TailleSelectionnee}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                                <DataGridTextColumn Header="Ordre" Binding="{Binding Ordre}" Width="70" />
                                <DataGridTextColumn Header="Articles" Binding="{Binding NombreUtilisations}" Width="75" />
                                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Ajouter"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouvelleTailleCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Activer / Désactiver"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatTailleCommand}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Couleurs -->
                <Border Grid.Column="6" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Couleurs"
                                   Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Couleurs}"
                                  SelectedItem="{Binding CouleurSelectionnee}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" CornerRadius="3"
                                                    BorderBrush="{StaticResource PinceauBordureForte}"
                                                    BorderThickness="1"
                                                    Background="{Binding Complement, Converter={StaticResource CodeCouleur}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
                                <DataGridTextColumn Header="Articles" Binding="{Binding NombreUtilisations}" Width="75" />
                                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Ajouter"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouvelleCouleurCommand}"
                                    Margin="0,0,6,6" />
                            <Button Content="Activer / Désactiver"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatCouleurCommand}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ Imprimante de tickets ============ -->
        <!--
            Réglage du poste, et non du magasin : l'imprimante est branchée
            sur cet ordinateur. Ces réglages sont enregistrés dans le dossier
            de l'utilisateur, pas dans la base de données.
        -->
        <TabItem Header="Imprimante de tickets">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Imprimante de ce poste"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,6" />

                            <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,16"
                                       Text="Le ticket part directement sur l'imprimante, à la bonne longueur, sans fichier à enregistrer ni lecteur PDF à ouvrir." />

                            <TextBlock Text="Imprimante" Style="{StaticResource TexteEtiquette}" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource ChampListe}"
                                          ItemsSource="{Binding Imprimantes}"
                                          SelectedItem="{Binding ImprimanteChoisie}" />

                                <Button Grid.Column="1"
                                        Content="Actualiser"
                                        Style="{StaticResource BoutonSecondaire}"
                                        Command="{Binding ActualiserImprimantesCommand}"
                                        ToolTip="Relire la liste des imprimantes installées dans Windows"
                                        Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="{Binding EtatImprimante}" TextWrapping="Wrap" Margin="0,0,0,18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TexteSecondaire}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImprimanteChoisieExiste}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource PinceauDanger}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Largeur du rouleau" Style="{StaticResource TexteEtiquette}" />

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                                <RadioButton GroupName="LargeurRouleau"
                                             Content="58 mm"
                                             IsChecked="{Binding Rouleau58}"
                                             FontSize="{StaticResource TailleNormale}"
                                             VerticalContentAlignment="Center"
                                             MinHeight="34"
                                             Margin="0,0,24,0" />

                                <RadioButton GroupName="LargeurRouleau"
                                             Content="80 mm"
                                             IsChecked="{Binding Rouleau80}"
                                             FontSize="{StaticResource TailleNormale}"
                                             VerticalContentAlignment="Center"
                                             MinHeight="34" />
                            </StackPanel>

                            <CheckBox Style="{StaticResource CaseACocher}"
                                      Content="Imprimer le ticket après chaque vente, sans demander"
                                      IsChecked="{Binding ImprimerSansDemander}" />

                            <CheckBox Style="{StaticResource CaseACocher}"
                                      Content="Imprimer le logo en tête du ticket"
                                      IsChecked="{Binding ImprimerLogo}" />

                            <CheckBox Style="{StaticResource CaseACocher}"
                                      Content="Couper le papier en fin de ticket"
                                      IsChecked="{Binding CouperPapier}"
                                      ToolTip="Sans effet sur une imprimante sans massicot : le papier se déchire alors à la main" />

                            <CheckBox Style="{StaticResource CaseACocher}"
                                      Content="Ouvrir le tiroir-caisse branché sur l'imprimante"
                                      IsChecked="{Binding OuvrirTiroir}"
                                      ToolTip="Seulement si un tiroir est relié à la prise de l'imprimante" />

                            <TextBlock Text="Exemplaires par vente" Style="{StaticResource TexteEtiquette}"
                                       Margin="0,14,0,4" />
                            <ComboBox Style="{StaticResource ChampListe}"
                                      ItemsSource="{Binding ChoixExemplaires}"
                                      SelectedItem="{Binding Exemplaires}"
                                      Width="90"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,22" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Imprimer un ticket d'essai"
                                        Style="{StaticResource BoutonSecondaire}"
                                        Command="{Binding ImprimerEssaiCommand}"
                                        ToolTip="Essaie les réglages affichés, même avant de les enregistrer"
                                        Margin="0,0,8,0" />

                                <Button Content="Enregistrer"
                                        Style="{StaticResource BoutonPrincipal}"
                                        Command="{Binding EnregistrerImprimanteCommand}" />
                            </StackPanel>

                            <Button Content="Ne plus utiliser d'imprimante (tickets en PDF)"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding RetirerImprimanteCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Installer l'imprimante"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,10"
                                       Text="1. Branchez l'imprimante sur un port USB et allumez-la." />

                            <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,10"
                                       Text="2. Installez le pilote fourni avec l'imprimante. Windows la fait alors apparaître sous un nom comme « POS-58 » ou « XP-58 »." />

                            <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,10"
                                       Text="3. Dans Windows, ouvrez Paramètres, Bluetooth et appareils, Imprimantes et scanners, choisissez l'imprimante et imprimez une page de test : elle doit sortir." />

                            <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,0,0,18"
                                       Text="4. Revenez ici : Actualiser, choisissez l'imprimante, réglez la largeur du rouleau, puis Imprimer un ticket d'essai. S'il est correct, Enregistrer." />

                            <Separator Margin="0,0,0,14" />

                            <TextBlock Text="Sans le pilote du fabricant"
                                       Style="{StaticResource TexteEtiquette}" />

                            <TextBlock Style="{StaticResource TexteSecondaire}"
                                       Text="Ajoutez l'imprimante dans Windows avec le pilote « Generic / Text Only », sur son port USB (USB001 en général). Le logiciel lui envoie lui-même ses commandes : ce pilote suffit." />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>
