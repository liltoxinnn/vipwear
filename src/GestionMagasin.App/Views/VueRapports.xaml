<UserControl x:Class="GestionMagasin.App.Views.VueRapports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Filtres de période ============ -->
        <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Période" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <ComboBox Style="{StaticResource ChampListe}"
                              Width="190"
                              ItemsSource="{Binding Periodes}"
                              SelectedItem="{Binding PeriodeChoisie}"
                              DisplayMemberPath="Libelle" />

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding PeriodePersonnalisee, Converter={StaticResource BooleenVisibilite}}">
                        <TextBlock Text="Du" Style="{StaticResource TexteSecondaire}"
                                   VerticalAlignment="Center" Margin="14,0,6,0" />
                        <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                    SelectedDate="{Binding DateDebut}" />

                        <TextBlock Text="au" Style="{StaticResource TexteSecondaire}"
                                   VerticalAlignment="Center" Margin="8,0,6,0" />
                        <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                    SelectedDate="{Binding DateFin}" />
                    </StackPanel>

                    <Button Content="Appliquer"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding AppliquerCommand}"
                            Margin="12,0,0,0" />

                    <TextBlock Text="{Binding LibellePeriode}"
                               Style="{StaticResource TexteAttenue}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Imprimer le rapport"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ImprimerCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="Exporter vers Excel"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ExporterCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ Indicateurs ============ -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Chiffre d'affaires net" Style="{StaticResource TexteEtiquette}" />
                            <TextBlock Text="{Binding Synthese.ChiffreAffaires, Converter={StaticResource Montant}}"
                                       FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource PinceauPrincipal}" />
                            <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                <Run Text="Brut : " />
                                <Run Text="{Binding Synthese.ChiffreAffairesBrut, Converter={StaticResource Montant}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Bénéfice estimé" Style="{StaticResource TexteEtiquette}" />
                            <TextBlock Text="{Binding Synthese.BeneficeEstime, Converter={StaticResource Montant}}"
                                       FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource PinceauSucces}" />
                            <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                <Run Text="Taux de marge : " />
                                <Run Text="{Binding Synthese.TauxMarge, Mode=OneWay, StringFormat={}{0:N2} %}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Ventes" Style="{StaticResource TexteEtiquette}" />
                            <TextBlock Text="{Binding Synthese.NombreVentes}"
                                       FontSize="19" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                <Run Text="Ticket moyen : " />
                                <Run Text="{Binding Synthese.TicketMoyen, Converter={StaticResource Montant}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Carte}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Articles vendus" Style="{StaticResource TexteEtiquette}" />
                            <TextBlock Text="{Binding Synthese.ArticlesVendus}"
                                       FontSize="19" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,3,0,0">
                                <Run Text="Retours : " />
                                <Run Text="{Binding Synthese.NombreRetours, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ============ Courbe d'évolution ============ -->
                <Border Style="{StaticResource Carte}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Évolution du chiffre d'affaires"
                                   Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                        <ItemsControl ItemsSource="{Binding Evolution}" Height="200">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Margin="1,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Rectangle Grid.Row="0"
                                                   Fill="{StaticResource PinceauAccent}"
                                                   VerticalAlignment="Bottom"
                                                   RadiusX="2" RadiusY="2">
                                            <Rectangle.Height>
                                                <MultiBinding Converter="{StaticResource Proportion}"
                                                              ConverterParameter="170">
                                                    <Binding Path="Valeur" />
                                                    <Binding Path="DataContext.MaximumEvolution"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </Rectangle.Height>
                                            <Rectangle.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Libelle}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Valeur, Converter={StaticResource Montant}}" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Rectangle.ToolTip>
                                        </Rectangle>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Libelle}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource PinceauTexteAttenue}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Classements ============ -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Produits les plus vendus"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <DataGrid ItemsSource="{Binding MeilleuresVentes}"
                                      Style="{StaticResource Tableau}" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*" />
                                    <DataGridTextColumn Header="Vendus" Binding="{Binding QuantiteVendue}" Width="70" />
                                    <DataGridTextColumn Header="Chiffre d'affaires"
                                                        Binding="{Binding ChiffreAffaires, Converter={StaticResource Montant}}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="Bénéfice"
                                                        Binding="{Binding Benefice, Converter={StaticResource Montant}}"
                                                        Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Produits les moins vendus"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <DataGrid ItemsSource="{Binding MoinsBonnesVentes}"
                                      Style="{StaticResource Tableau}" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*" />
                                    <DataGridTextColumn Header="Vendus" Binding="{Binding QuantiteVendue}" Width="70" />
                                    <DataGridTextColumn Header="Stock actuel" Binding="{Binding StockActuel}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Employés et paiements ============ -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Ventes par employé"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <DataGrid ItemsSource="{Binding VentesParEmploye}"
                                      Style="{StaticResource Tableau}" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employé" Binding="{Binding Utilisateur}" Width="*" />
                                    <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="120" />
                                    <DataGridTextColumn Header="Ventes" Binding="{Binding NombreVentes}" Width="70" />
                                    <DataGridTextColumn Header="Chiffre d'affaires"
                                                        Binding="{Binding ChiffreAffaires, Converter={StaticResource Montant}}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="Ticket moyen"
                                                        Binding="{Binding TicketMoyen, Converter={StaticResource Montant}}"
                                                        Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Ventes par mode de paiement"
                                       Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <DataGrid ItemsSource="{Binding VentesParModePaiement}"
                                      Style="{StaticResource Tableau}" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mode de paiement" Binding="{Binding ModePaiement}" Width="*" />
                                    <DataGridTextColumn Header="Règlements" Binding="{Binding NombreReglements}" Width="110" />
                                    <DataGridTextColumn Header="Montant"
                                                        Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Part"
                                                        Binding="{Binding Pourcentage, StringFormat={}{0:N1} %}"
                                                        Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Achats, retours, stock ============ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Achats" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Commandes" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseAchats.NombreCommandes}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Articles commandés" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseAchats.ArticlesCommandes}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Articles reçus" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseAchats.ArticlesRecus}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Total" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseAchats.TotalCommandes, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Reste dû" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseAchats.TotalRestantDu, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PinceauDanger}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Retours" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Nombre de retours" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseRetours.NombreRetours}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Articles repris" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseRetours.ArticlesRepris}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Remis en stock" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseRetours.ArticlesRemisEnStock}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Endommagés" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseRetours.ArticlesEndommages}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PinceauDanger}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Taux de retour" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseRetours.TauxRetour, StringFormat={}{0:N2} %}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Carte}">
                        <StackPanel>
                            <TextBlock Text="Stock" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Références" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseStock.NombreReferences}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Articles en rayon" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseStock.QuantiteTotale}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Valeur d'achat" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseStock.ValeurAuPrixAchat, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Valeur de vente" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseStock.ValeurAuPrixVente, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Marge potentielle" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SyntheseStock.MargePotentielle, Converter={StaticResource Montant}}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PinceauSucces}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
