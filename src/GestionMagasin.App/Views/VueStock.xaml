<UserControl x:Class="GestionMagasin.App.Views.VueStock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Synthèse ============ -->
        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Déclinaisons" Style="{StaticResource TexteEtiquette}" />
                    <TextBlock Text="{Binding Synthese.NombreDeclinaisons}"
                               FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Articles en rayon" Style="{StaticResource TexteEtiquette}" />
                    <TextBlock Text="{Binding Synthese.QuantiteTotale}"
                               FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Valeur d'achat" Style="{StaticResource TexteEtiquette}" />
                    <TextBlock Text="{Binding Synthese.ValeurAuPrixAchat, Converter={StaticResource Montant}}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource PinceauPrincipal}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Stock faible" Style="{StaticResource TexteEtiquette}" />
                    <TextBlock Text="{Binding Synthese.NombreStockFaible}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PinceauAvertissement}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Ruptures" Style="{StaticResource TexteEtiquette}" />
                    <TextBlock Text="{Binding Synthese.NombreRuptures}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PinceauDanger}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ Filtres et actions ============ -->
        <Border Grid.Row="1" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ChampTexte}"
                             Width="240"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SurToucheRecherche"
                             ToolTip="Nom, référence, code article ou code-barres" />

                    <Button Content="Rechercher"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding RechercherCommand}"
                            Margin="8,0,0,0" />

                    <Button Content="Stock faible"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AfficherStockFaibleCommand}"
                            Margin="14,0,0,0" />

                    <Button Content="Ruptures"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AfficherRupturesCommand}"
                            Margin="8,0,0,0" />

                    <Button Content="Tout afficher"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ReinitialiserFiltresCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Imprimer l'état"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ImprimerCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="Exporter"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ExporterExcelCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="Ajuster le stock"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AjusterStockCommand}"
                            IsEnabled="{Binding PeutModifierStock}"
                            Margin="0,0,8,0"
                            ToolTip="Fixer la quantité constatée lors d'un inventaire physique" />

                    <Button Content="Nouveau mouvement"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding NouveauMouvementCommand}"
                            IsEnabled="{Binding PeutModifierStock}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Stock et historique ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <!--
                        Deux niveaux. La liste des produits d'abord : le stock
                        se compte par déclinaison, mais un catalogue de deux
                        cents produits en quatre couleurs et six tailles ferait
                        cinq mille lignes, où personne ne lirait rien.

                        Le détail — couleurs, tailles, seuils — s'ouvre au clic
                        sur un produit. C'est là que se corrigent les
                        quantités, car c'est là que le stock existe vraiment.
                    -->

                    <!-- Niveau 1 : un produit par ligne -->
                    <Grid Visibility="{Binding ProduitOuvert, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,10">
                            <TextBlock Style="{StaticResource TexteSousTitre}" VerticalAlignment="Center">
                                <Run Text="État du stock (" /><Run Text="{Binding Produits.Count, Mode=OneWay}" /><Run Text=" produits)" />
                            </TextBlock>

                            <TextBlock Text="Cliquez sur un produit pour voir ses tailles et ses couleurs"
                                       Style="{StaticResource TexteAttenue}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Produits}"
                                  SelectedItem="{Binding ProduitSelectionne}"
                                  Style="{StaticResource Tableau}"
                                  RowHeight="46">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding OuvrirProduitCommand}"
                                              CommandParameter="{Binding ProduitSelectionne}" />
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Produit" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProduitNom}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Resume}"
                                                           Style="{StaticResource TexteAttenue}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="130" />
                                <DataGridTextColumn Header="Déclinaisons" Binding="{Binding NombreDeclinaisons}" Width="105" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockTotal}" Width="75" />
                                <DataGridTextColumn Header="Valeur"
                                                    Binding="{Binding ValeurStock, Converter={StaticResource Montant}}"
                                                    Width="120" />

                                <DataGridTextColumn Header="À réapprovisionner"
                                                    Binding="{Binding LibelleAlerte}"
                                                    Width="150" />

                                <DataGridTemplateColumn Header="Situation" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pastille}"
                                                    Background="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                                <TextBlock Text="{Binding LibelleEtat}"
                                                           Style="{StaticResource TextePastille}"
                                                           Foreground="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Détail ›"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Command="{Binding DataContext.OuvrirProduitCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3"
                                                    MinHeight="28"
                                                    FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Niveau 2 : les déclinaisons du produit ouvert -->
                    <Grid Visibility="{Binding ProduitOuvert, Converter={StaticResource NonVideVisibilite}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource PinceauFondOr}"
                                    BorderBrush="{StaticResource PinceauOr}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="4,0,4,10">
                                <Grid DataContext="{Binding ProduitOuvert}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProduitNom}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinceauTexte}" />

                                        <TextBlock Style="{StaticResource TexteSecondaire}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding Resume, Mode=OneWay}" />
                                            <Run Text="—" />
                                            <Run Text="{Binding StockTotal, Mode=OneWay}" />
                                            <Run Text="articles en rayon" />
                                        </TextBlock>

                                        <TextBlock Text="Cliquez sur une quantité pour la corriger"
                                                   Style="{StaticResource TexteAttenue}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Content="Retour à la liste"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Command="{Binding DataContext.FermerProduitCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="12,5"
                                            MinHeight="32"
                                            FontSize="12" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Declinaisons}"
                                      SelectedItem="{Binding LigneSelectionnee}"
                                      Style="{StaticResource Tableau}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Couleur" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="12" Height="12"
                                                            CornerRadius="6"
                                                            BorderBrush="{StaticResource PinceauBordureForte}"
                                                            BorderThickness="1"
                                                            Background="{Binding CodeCouleur, Converter={StaticResource CodeCouleur}}"
                                                            VerticalAlignment="Center" />

                                                    <TextBlock Text="{Binding Couleur}"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="80" />
                                    <DataGridTextColumn Header="Code article" Binding="{Binding Sku}" Width="*" />

                                    <!--
                                        La quantité se corrige d'un clic : le
                                        chiffre est lui-même le bouton qui
                                        ouvre l'ajustement de cette
                                        déclinaison.
                                    -->
                                    <DataGridTemplateColumn Header="Stock" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource QuantiteCliquable}"
                                                        Content="{Binding QuantiteDisponible}"
                                                        Command="{Binding DataContext.AjusterLigneCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.PeutModifierStock,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Corriger la quantité de cette taille" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Seuil" Binding="{Binding SeuilMinimum}" Width="70" />
                                    <DataGridTextColumn Header="Valeur"
                                                        Binding="{Binding ValeurStock, Converter={StaticResource Montant}}"
                                                        Width="120" />

                                    <DataGridTemplateColumn Header="Situation" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pastille}"
                                                        Background="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                                    <TextBlock Text="{Binding LibelleEtat}"
                                                               Style="{StaticResource TextePastille}"
                                                               Foreground="{Binding LibelleEtat, Converter={StaticResource CouleurEtat}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Text="Historique des mouvements" Style="{StaticResource TexteSousTitre}" />
                        <TextBlock Text="{Binding LigneSelectionnee.Designation}"
                                   Style="{StaticResource TexteAttenue}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Historique}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateCreation, Converter={StaticResource Date}, ConverterParameter=heure}"
                                                Width="130" />
                            <DataGridTextColumn Header="Type" Binding="{Binding LibelleTypeMouvement}" Width="130" />
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="60" />
                            <DataGridTextColumn Header="Avant" Binding="{Binding AncienneQuantite}" Width="60" />
                            <DataGridTextColumn Header="Après" Binding="{Binding NouvelleQuantite}" Width="60" />
                            <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*" />
                            <DataGridTextColumn Header="Document" Binding="{Binding ReferenceDocument}" Width="130" />
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Aucun mouvement enregistré pour cet article."
                                   Style="{StaticResource TexteAttenue}"
                                   Margin="4,0,0,8"
                                   Visibility="{Binding Historique.Count,
                                                Converter={StaticResource NonVideVisibilite},
                                                ConverterParameter=inverse}" />

                        <Button Content="Exporter tout l'historique"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ExporterHistoriqueCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
