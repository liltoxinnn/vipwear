<UserControl x:Class="GestionMagasin.App.Views.VueAchats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ChampTexte}"
                             Width="200"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SurToucheRecherche"
                             ToolTip="Numéro de commande ou nom du fournisseur" />

                    <TextBlock Text="Du" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateDebut}" />

                    <TextBlock Text="au" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="8,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateFin}" />

                    <ComboBox Style="{StaticResource ChampListe}"
                              Width="190" Margin="10,0,0,0"
                              ItemsSource="{Binding Statuts}"
                              SelectedItem="{Binding StatutFiltre}"
                              ToolTip="Filtrer par statut" />

                    <Button Content="Rechercher"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding RechercherCommand}"
                            Margin="10,0,0,0" />

                    <Button Content="Réinitialiser"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ReinitialiserFiltresCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Exporter"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ExporterCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="Nouvelle commande"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding NouvelleCommandeCommand}"
                            IsEnabled="{Binding PeutGerer}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Style="{StaticResource TexteSousTitre}">
                            <Run Text="{Binding Achats.Count, Mode=OneWay}" /><Run Text=" commande(s)" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="Total : " Foreground="#5A6577" />
                                <Run Text="{Binding TotalPeriode, Converter={StaticResource Montant}, Mode=OneWay}"
                                     FontWeight="Bold" Foreground="#1F3864" />
                            </TextBlock>

                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Reste à payer : " Foreground="#5A6577" />
                                <Run Text="{Binding ResteAPayer, Converter={StaticResource Montant}, Mode=OneWay}"
                                     FontWeight="Bold" Foreground="#C0392B" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Achats}"
                              SelectedItem="{Binding AchatSelectionne}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° de commande" Binding="{Binding NumeroAchat}" Width="150" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateAchat, Converter={StaticResource Date}}"
                                                Width="110" />
                            <DataGridTextColumn Header="Fournisseur" Binding="{Binding FournisseurNom}" Width="*" />
                            <DataGridTextColumn Header="Art." Binding="{Binding NombreArticles}" Width="60" />
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="130" />
                            <DataGridTextColumn Header="Reste dû"
                                                Binding="{Binding MontantRestant, Converter={StaticResource Montant}}"
                                                Width="130" />
                            <DataGridTemplateColumn Header="Statut" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pastille}"
                                                Background="{Binding LibelleStatut, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                            <TextBlock Text="{Binding LibelleStatut}"
                                                       Style="{StaticResource TextePastille}"
                                                       Foreground="{Binding LibelleStatut, Converter={StaticResource CouleurEtat}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Sélectionnez une commande pour afficher son détail."
                               Style="{StaticResource TexteAttenue}"
                               Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}" />

                    <StackPanel Grid.Row="0"
                                Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <TextBlock Text="{Binding Detail.NumeroAchat}" Style="{StaticResource TexteSousTitre}" />

                        <TextBlock Text="{Binding Detail.FournisseurNom}"
                                   Style="{StaticResource TexteSecondaire}" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,4,0,10">
                            <Run Text="Commandé le " />
                            <Run Text="{Binding Detail.DateAchat, Converter={StaticResource Date}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Detail.Lignes}"
                              Style="{StaticResource Tableau}"
                              Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*" />
                            <DataGridTextColumn Header="Cmd." Binding="{Binding Quantite}" Width="55" />
                            <DataGridTextColumn Header="Reçu" Binding="{Binding QuantiteRecue}" Width="55" />
                            <DataGridTextColumn Header="Prix"
                                                Binding="{Binding PrixUnitaire, Converter={StaticResource Montant}}"
                                                Width="110" />
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="{Binding Detail.Total, Converter={StaticResource Montant}}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource PinceauPrincipal}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Déjà réglé" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding Detail.MontantPaye, Converter={StaticResource Montant}}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Reste à payer" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding Detail.MontantRestant, Converter={StaticResource Montant}}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PinceauDanger}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <WrapPanel Grid.Row="3" Margin="0,14,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <Button Content="Réception partielle"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ReceptionnerCommand}"
                                IsEnabled="{Binding PeutGerer}"
                                Margin="0,0,8,8" />

                        <Button Content="Tout réceptionner"
                                Style="{StaticResource BoutonSucces}"
                                Command="{Binding ReceptionnerToutCommand}"
                                IsEnabled="{Binding PeutGerer}"
                                Margin="0,0,8,8" />

                        <Button Content="Enregistrer un règlement"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding EnregistrerReglementCommand}"
                                IsEnabled="{Binding PeutGerer}"
                                Margin="0,0,8,8" />

                        <Button Content="Imprimer le bon"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ImprimerBonCommand}"
                                Margin="0,0,8,8" />

                        <Button Content="Annuler la commande"
                                Style="{StaticResource BoutonDanger}"
                                Command="{Binding AnnulerCommandeCommand}"
                                IsEnabled="{Binding PeutGerer}"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
