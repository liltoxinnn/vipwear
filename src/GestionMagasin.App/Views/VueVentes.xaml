<UserControl x:Class="GestionMagasin.App.Views.VueVentes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Filtres ============ -->
        <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ChampTexte}"
                             Width="200"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SurToucheRecherche"
                             ToolTip="Numéro de vente, nom ou téléphone du client" />

                    <TextBlock Text="Du" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="12,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateDebut}" />

                    <TextBlock Text="au" Style="{StaticResource TexteSecondaire}"
                               VerticalAlignment="Center" Margin="8,0,6,0" />
                    <DatePicker Style="{StaticResource ChampDate}" Width="140"
                                SelectedDate="{Binding DateFin}" />

                    <ComboBox Style="{StaticResource ChampListeEnum}"
                              Width="170" Margin="10,0,0,0"
                              ItemsSource="{Binding Statuts}"
                              SelectedItem="{Binding StatutFiltre}"
                              ToolTip="Filtrer par statut" />

                    <Button Content="Rechercher"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding RechercherCommand}"
                            Margin="10,0,0,0" />

                    <Button Content="Aujourd'hui"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AfficherAujourdhuiCommand}"
                            Margin="8,0,0,0" />

                    <Button Content="Réinitialiser"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding ReinitialiserFiltresCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Exporter"
                        Style="{StaticResource BoutonSecondaire}"
                        Command="{Binding ExporterCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des ventes -->
            <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Style="{StaticResource TexteSousTitre}">
                            <Run Text="{Binding NombreVentes, Mode=OneWay}" /><Run Text=" vente(s)" />
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="Total : " Foreground="#5A6577" />
                            <Run Text="{Binding TotalPeriode, Converter={StaticResource Montant}, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="#1F3864" />
                        </TextBlock>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Ventes}"
                              SelectedItem="{Binding VenteSelectionnee}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° de vente" Binding="{Binding NumeroVente}" Width="140" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateVente, Converter={StaticResource Date}, ConverterParameter=heure}"
                                                Width="140" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientNom}" Width="*" />
                            <DataGridTextColumn Header="Vendeur" Binding="{Binding UtilisateurNom}" Width="150" />
                            <DataGridTextColumn Header="Art." Binding="{Binding NombreArticles}" Width="60" />
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="130" />
                            <DataGridTemplateColumn Header="Statut" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pastille}"
                                                Background="{Binding LibelleStatut, Converter={StaticResource CouleurEtat}, ConverterParameter=fond}">
                                            <TextBlock Text="{Binding LibelleStatut}"
                                                       Style="{StaticResource TextePastille}"
                                                       Foreground="{Binding LibelleStatut, Converter={StaticResource CouleurEtat}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Détail de la vente -->
            <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Sélectionnez une vente pour afficher son détail."
                               Style="{StaticResource TexteAttenue}"
                               Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}" />

                    <StackPanel Grid.Row="0"
                                Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <TextBlock Text="{Binding Detail.NumeroVente}" Style="{StaticResource TexteSousTitre}" />

                        <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,4,0,0">
                            <Run Text="{Binding Detail.DateVente, Converter={StaticResource Date}, ConverterParameter=heure, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding Detail.UtilisateurNom, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource TexteSecondaire}" Margin="0,6,0,10">
                            <Run Text="Client : " />
                            <Run Text="{Binding Detail.ClientNom, Mode=OneWay, TargetNullValue=Client de passage}" />
                        </TextBlock>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Detail.Lignes}"
                              Style="{StaticResource Tableau}"
                              Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*" />
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="55" />
                            <DataGridTextColumn Header="Prix"
                                                Binding="{Binding PrixUnitaire, Converter={StaticResource Montant}}"
                                                Width="110" />
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Retourné" Binding="{Binding QuantiteRetournee}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totaux et règlements -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Sous-total" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding Detail.SousTotal, Converter={StaticResource Montant}}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Remise" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding Detail.Remise, Converter={StaticResource Montant}}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,4" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="{Binding Detail.Total, Converter={StaticResource Montant}}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource PinceauPrincipal}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Montant payé" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding Detail.MontantPaye, Converter={StaticResource Montant}}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Detail.Paiements}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="{Binding LibelleModePaiement}"
                                                   Style="{StaticResource TexteAttenue}" />
                                        <TextBlock Text="{Binding Montant, Converter={StaticResource Montant}}"
                                                   Style="{StaticResource TexteAttenue}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Actions -->
                    <WrapPanel Grid.Row="3" Margin="0,14,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource NonVideVisibilite}}">
                        <Button Content="Imprimer le ticket"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ImprimerTicketCommand}"
                                Margin="0,0,8,8" />

                        <Button Content="Imprimer la facture"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ImprimerFactureCommand}"
                                Margin="0,0,8,8" />

                        <Button Content="Encaisser le solde"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding EncaisserResteCommand}"
                                Margin="0,0,8,8" />

                        <Button Content="Annuler la vente"
                                Style="{StaticResource BoutonDanger}"
                                Command="{Binding AnnulerVenteCommand}"
                                IsEnabled="{Binding PeutAnnuler}"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
