<UserControl x:Class="GestionMagasin.App.Views.VueCaisse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ================= Panier et recherche ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Scan -->
            <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Code-barres — scannez l'article ou saisissez son code"
                                   Style="{StaticResource TexteEtiquette}" />
                        <TextBox x:Name="ChampScan"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding CodeScanne, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheScan" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Ajouter"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding ScannerCommand}"
                            VerticalAlignment="Bottom"
                            Height="48" Width="110"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- Recherche par nom -->
            <Border Grid.Row="1" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ChampTexte}"
                                 Text="{Binding TermeRecherche, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheRecherche"
                                 ToolTip="Rechercher par nom de produit, référence ou code article" />

                        <Button Grid.Column="1"
                                Content="Rechercher"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding RechercherCommand}"
                                Width="120"
                                Margin="10,0,0,0" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding ResultatsRecherche}"
                              Style="{StaticResource Tableau}"
                              MaxHeight="180"
                              Margin="0,10,0,0"
                              MouseDoubleClick="SurDoubleClicResultat"
                              Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code article" Binding="{Binding Sku}" Width="150" />
                            <DataGridTextColumn Header="Couleur" Binding="{Binding Couleur}" Width="110" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="80" />
                            <DataGridTextColumn Header="Prix"
                                                Binding="{Binding PrixVente, Converter={StaticResource Montant}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding QuantiteDisponible}" Width="70" />
                            <DataGridTemplateColumn Header="Action" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ajouter"
                                                Style="{StaticResource BoutonSecondaire}"
                                                Padding="8,3"
                                                MinHeight="26"
                                                FontSize="11"
                                                Command="{Binding DataContext.AjouterArticleCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Panier -->
            <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Text="Panier" Style="{StaticResource TexteSousTitre}" />
                        <Button Content="Vider le panier"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ViderPanierCommand}"
                                HorizontalAlignment="Right"
                                Padding="12,5"
                                MinHeight="30"
                                FontSize="12" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Panier}"
                              SelectedItem="{Binding LigneSelectionnee}"
                              Style="{StaticResource Tableau}"
                              IsReadOnly="False"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code article" Binding="{Binding Sku}"
                                                Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}"
                                                Width="*" IsReadOnly="True" />

                            <DataGridTemplateColumn Header="Quantité" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="−"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Width="28" MinHeight="26" Padding="0"
                                                    FontSize="14"
                                                    Command="{Binding DataContext.DiminuerQuantiteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <TextBlock Text="{Binding Quantite}"
                                                       Width="38"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />

                                            <Button Content="+"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Width="28" MinHeight="26" Padding="0"
                                                    FontSize="14"
                                                    Command="{Binding DataContext.AugmenterQuantiteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Prix unitaire"
                                                Binding="{Binding PrixUnitaire, StringFormat={}{0:N2}}"
                                                Width="120" />

                            <DataGridTextColumn Header="Remise"
                                                Binding="{Binding Remise, StringFormat={}{0:N2}}"
                                                Width="110" />

                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="140" IsReadOnly="True" />

                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Style="{StaticResource BoutonSecondaire}"
                                                Foreground="{StaticResource PinceauDanger}"
                                                Width="28" MinHeight="26" Padding="0"
                                                ToolTip="Retirer cet article du panier"
                                                Command="{Binding DataContext.RetirerLigneCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Encaissement ================= -->
        <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Encaissement" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                    <TextBlock Text="Client (facultatif)" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListe}"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding ClientSelectionne}"
                              DisplayMemberPath="NomComplet"
                              IsEditable="False"
                              Margin="0,0,0,14" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- Totaux -->
                    <Border Background="{StaticResource PinceauSurfaceAlterne}"
                            CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Articles" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding NombreArticles}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sous-total" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SousTotal, Converter={StaticResource Montant}}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,8" Visibility="{Binding PeutAccorderRemise,
                                                                Converter={StaticResource BooleenVisibilite}}">
                                <TextBlock Text="Remise sur le ticket" Style="{StaticResource TexteSecondaire}"
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource ChampTexte}"
                                         Text="{Binding RemiseGlobale, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                                         Width="110" MinHeight="30" Padding="7,4"
                                         HorizontalAlignment="Right"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <Separator Margin="0,4,0,10" />

                            <Grid>
                                <TextBlock Text="TOTAL" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{Binding Total, Converter={StaticResource Montant}}"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource PinceauPrincipal}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Règlement -->
                    <TextBlock Text="Mode de paiement" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListe}"
                              ItemsSource="{Binding ModesPaiement}"
                              SelectedItem="{Binding ModePaiement}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Montant reçu" Style="{StaticResource TexteEtiquette}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding MontantRecu, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 HorizontalContentAlignment="Right" />

                        <Button Grid.Column="1"
                                Content="Appoint"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding MontantExactCommand}"
                                Width="90" Height="48"
                                Margin="8,0,0,0"
                                ToolTip="Saisir automatiquement le montant exact" />
                    </Grid>

                    <Border Background="{StaticResource PinceauFondSucces}"
                            CornerRadius="6" Padding="12"
                            Visibility="{Binding MonnaieARendre, Converter={StaticResource NonVideVisibilite}}">
                        <Grid>
                            <TextBlock Text="Monnaie à rendre" FontWeight="SemiBold"
                                       Foreground="{StaticResource PinceauSucces}" />
                            <TextBlock Text="{Binding MonnaieARendre, Converter={StaticResource Montant}}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PinceauSucces}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding MessageStatut}"
                               Style="{StaticResource TexteAttenue}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"
                               Visibility="{Binding MessageStatut, Converter={StaticResource NonVideVisibilite}}" />

                    <Button Content="VALIDER LA VENTE"
                            Style="{StaticResource BoutonCaisse}"
                            Background="{StaticResource PinceauSucces}"
                            BorderBrush="{StaticResource PinceauSucces}"
                            Command="{Binding ValiderVenteCommand}"
                            IsEnabled="{Binding PanierNonVide}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
