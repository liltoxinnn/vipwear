<UserControl x:Class="GestionMagasin.App.Views.VueCaisse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ================= Rayon ================= -->
        <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Les trois manières d'ajouter un article se valent : la
                    douchette, la recherche, ou le doigt sur le rayon. Le
                    caissier prend la plus rapide selon le cas — étiquette
                    lisible, article connu de nom, ou étiquette arrachée.
                -->
                <Grid Grid.Row="0" Margin="16,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="3" Height="12"
                                    Background="{StaticResource PinceauOr}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Scanner un code-barres"
                                       Style="{StaticResource TexteEtiquette}"
                                       Margin="7,0,0,0" />
                        </StackPanel>

                        <TextBox x:Name="ChampScan"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding CodeScanne, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheScan"
                                 ToolTip="Passez l'article à la douchette, ou tapez son code puis Entrée" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Ajouter"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding ScannerCommand}"
                            VerticalAlignment="Bottom"
                            Height="48" Width="100"
                            Margin="10,0,0,0" />

                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="3" Height="12"
                                    Background="{StaticResource PinceauOr}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Rechercher un article"
                                       Style="{StaticResource TexteEtiquette}"
                                       Margin="7,0,0,0" />
                        </StackPanel>

                        <TextBox Style="{StaticResource ChampScan}"
                                 Text="{Binding TermeRecherche, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheRecherche"
                                 ToolTip="Nom du produit, référence ou code article, puis Entrée" />
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Rechercher"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding RechercherCommand}"
                            VerticalAlignment="Bottom"
                            Height="48" Width="115"
                            Margin="10,0,0,0" />
                </Grid>

                <!-- Familles : un onglet par rayon réellement garni -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource PinceauBordure}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0"
                        Visibility="{Binding ResultatsRecherche.Count,
                                     Converter={StaticResource NonVideVisibilite},
                                     ConverterParameter=inverse}">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Familles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource OngletRayon}"
                                                 GroupName="FamillesDuRayon"
                                                 Content="{Binding Nom}"
                                                 Command="{Binding DataContext.ChoisirFamilleCommand,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 IsChecked="{Binding EstActive, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Retour au rayon complet après une recherche -->
                <Border Grid.Row="2"
                        Background="{StaticResource PinceauFondOr}"
                        BorderBrush="{StaticResource PinceauOr}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        Margin="16,12,16,0"
                        Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}}">
                    <Grid>
                        <TextBlock Style="{StaticResource TexteSecondaire}" VerticalAlignment="Center">
                            <Run Text="Résultats de la recherche :" />
                            <Run Text="{Binding ResultatsRecherche.Count, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="article(s)" />
                        </TextBlock>

                        <Button Content="Revoir tout le rayon"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding EffacerRechercheCommand}"
                                HorizontalAlignment="Right"
                                Padding="14,6"
                                MinHeight="36"
                                FontSize="12.5" />
                    </Grid>
                </Border>

                <!--
                    La barre de défilement est toujours réservée, jamais
                    « Auto ». Les vignettes se répartissent selon la largeur
                    disponible : si la barre apparaissait et disparaissait,
                    cette largeur changerait à chaque mesure, les vignettes se
                    redistribueraient, et la mise en page ne se stabiliserait
                    jamais. Windows arrête alors le programme, pile d'appels
                    saturée, sans erreur ni trace.
                -->
                <Grid Grid.Row="3" Margin="0,12,0,0">

                    <!-- Résultats d'une recherche : des déclinaisons précises -->
                    <ScrollViewer VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,10,14"
                                  Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}}">
                        <ItemsControl ItemsSource="{Binding ResultatsRecherche}"
                                      ItemTemplate="{StaticResource CarteArticle}"
                                      ItemsPanel="{StaticResource GrilleArticles}" />
                    </ScrollViewer>

                    <!-- Rayon, affiché par défaut -->
                    <Grid Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}">

                        <Grid Visibility="{Binding ArticleChoisi, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}">
                            <ScrollViewer VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="16,0,10,14">
                                <ItemsControl ItemsSource="{Binding Catalogue}"
                                              ItemTemplate="{StaticResource CarteProduit}"
                                              ItemsPanel="{StaticResource GrilleArticles}" />
                            </ScrollViewer>

                            <TextBlock Text="Aucun article en stock dans ce rayon."
                                       Style="{StaticResource TexteAttenue}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding CatalogueVide, Converter={StaticResource BooleenVisibilite}}" />
                        </Grid>

                        <!--
                            Choix de la couleur et de la taille, pour les
                            produits trop déclinés pour tenir sur leur vignette.

                            La visibilité est portée par ce conteneur, et le
                            contexte de données par la grille qu'il enferme.
                            Les deux sur le même élément ne fonctionneraient
                            pas : une liaison écrite à côté d'un
                            « DataContext » est résolue dans le NOUVEAU
                            contexte, échouerait sans bruit, et le choix
                            resterait affiché par-dessus le rayon.
                        -->
                        <Grid Visibility="{Binding ArticleChoisi, Converter={StaticResource NonVideVisibilite}}">
                          <Grid DataContext="{Binding ArticleChoisi}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource PinceauFondOr}"
                                    BorderBrush="{StaticResource PinceauOr}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="16,0,16,12">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nom}"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinceauTexte}" />

                                        <TextBlock Text="Choisissez la couleur, puis la taille"
                                                   Style="{StaticResource TexteSecondaire}"
                                                   FontSize="12.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Button Content="Retour au rayon"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Command="{Binding DataContext.FermerChoixCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="14,6"
                                            MinHeight="40"
                                            FontSize="12.5" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="16,0,10,14">
                                <ItemsControl ItemsSource="{Binding Article.Couleurs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,18">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                    <Border Width="18" Height="18"
                                                            CornerRadius="9"
                                                            BorderBrush="{StaticResource PinceauBordureForte}"
                                                            BorderThickness="1"
                                                            Background="{Binding Code, Converter={StaticResource CodeCouleur}}"
                                                            VerticalAlignment="Center" />

                                                    <TextBlock Text="{Binding Nom}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PinceauTexte}"
                                                               Margin="9,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Style="{StaticResource TexteAttenue}"
                                                               FontSize="11.5"
                                                               Margin="9,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <Run Text="—" />
                                                        <Run Text="{Binding StockTotal, Mode=OneWay}" />
                                                        <Run Text="en stock" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Tailles}"
                                                              ItemTemplate="{StaticResource CaseTaille}"
                                                              ItemsPanel="{StaticResource GrilleArticles}"
                                                              Margin="27,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                          </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Panier et encaissement ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Panier : une ligne riche par article, lisible au comptoir -->
            <Border Grid.Row="0" Style="{StaticResource Carte}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,15,14,13">
                        <StackPanel>
                            <TextBlock Text="Panier" Style="{StaticResource TexteSousTitre}" />
                            <TextBlock Style="{StaticResource TexteAttenue}" FontSize="11.5" Margin="0,1,0,0">
                                <Run Text="{Binding NombreArticles, Mode=OneWay}" />
                                <Run Text="article(s)" />
                            </TextBlock>
                        </StackPanel>

                        <Button Content="Vider le panier"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ViderPanierCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="12,6"
                                MinHeight="38"
                                FontSize="12" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="11,0,11,12">
                            <ItemsControl ItemsSource="{Binding Panier}"
                                          ItemTemplate="{StaticResource LignePanier}" />
                        </ScrollViewer>

                        <TextBlock Text="Scannez ou choisissez un article pour commencer la vente."
                                   Style="{StaticResource TexteAttenue}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="230"
                                   Visibility="{Binding PanierNonVide,
                                                Converter={StaticResource BooleenVisibilite},
                                                ConverterParameter=inverse}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Encaissement -->
            <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="16,15">
                <StackPanel>
                    <TextBlock Text="Encaissement" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,12" />

                    <TextBlock Text="Client (facultatif)" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListe}"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding ClientSelectionne}"
                              DisplayMemberPath="NomComplet"
                              Margin="0,0,0,12" />

                    <Border Background="{StaticResource PinceauSurfaceAlterne}"
                            BorderBrush="{StaticResource PinceauBordure}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13,11"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Articles" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding NombreArticles}"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sous-total" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SousTotal, Converter={StaticResource Montant}}"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding PeutAccorderRemise, Converter={StaticResource BooleenVisibilite}}">
                                <TextBlock Text="Remise sur le ticket"
                                           Style="{StaticResource TexteSecondaire}"
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource ChampTexte}"
                                         Text="{Binding RemiseGlobale, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         Width="112"
                                         MinHeight="40"
                                         HorizontalAlignment="Right"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <Border BorderBrush="{StaticResource PinceauBordureForte}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="TOTAL"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock Text="{Binding Total, Converter={StaticResource Montant}}"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinceauTexte}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Mode de paiement" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListeEnum}"
                              ItemsSource="{Binding ModesPaiement}"
                              SelectedItem="{Binding ModePaiement}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Montant reçu" Style="{StaticResource TexteEtiquette}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding MontantRecu, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 HorizontalContentAlignment="Right"
                                 FontWeight="Bold" />

                        <Button Grid.Column="1"
                                Content="Appoint"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding MontantExactCommand}"
                                Width="96" Height="48"
                                Margin="9,0,0,0"
                                ToolTip="Le client donne le compte exact" />
                    </Grid>

                    <!-- Monnaie à rendre : le chiffre que le caissier annonce -->
                    <Border Background="{StaticResource PinceauFondOr}"
                            BorderBrush="{StaticResource PinceauOr}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13,11"
                            Margin="0,0,0,12"
                            Visibility="{Binding MonnaieARendre, Converter={StaticResource NonVideVisibilite}}">
                        <Grid>
                            <TextBlock Text="MONNAIE À RENDRE"
                                       Style="{StaticResource TexteEtiquette}"
                                       Foreground="{StaticResource PinceauOrFonce}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MonnaieARendre, Converter={StaticResource Montant}}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinceauOrFonce}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding MessageStatut}"
                               Style="{StaticResource TexteAttenue}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Visibility="{Binding MessageStatut, Converter={StaticResource NonVideVisibilite}}" />

                    <Button Content="VALIDER LA VENTE"
                            Style="{StaticResource BoutonCaisse}"
                            Background="{StaticResource PinceauSucces}"
                            BorderBrush="{StaticResource PinceauSucces}"
                            MinHeight="58"
                            Command="{Binding ValiderVenteCommand}"
                            IsEnabled="{Binding PanierNonVide}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
