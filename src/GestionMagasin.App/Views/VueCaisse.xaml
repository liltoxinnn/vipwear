<UserControl x:Class="GestionMagasin.App.Views.VueCaisse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ================= Panier et recherche ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="290" />
            </Grid.RowDefinitions>

            <!--
                Les trois manières d'ajouter un article se valent : la douchette,
                la recherche, ou le clic dans le rayon plus bas. Le caissier
                prend la plus rapide selon le cas — étiquette lisible, article
                connu de nom, ou étiquette arrachée.
            -->
            <Border Grid.Row="0" Style="{StaticResource BarreOutils}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Douchette : le champ garde le focus en permanence -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="3" Height="12"
                                    Background="{StaticResource PinceauOr}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Scanner un code-barres"
                                       Style="{StaticResource TexteEtiquette}"
                                       Margin="7,0,0,0" />
                        </StackPanel>

                        <TextBox x:Name="ChampScan"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding CodeScanne, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheScan"
                                 ToolTip="Passez l'article à la douchette, ou tapez son code puis Entrée" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Ajouter"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding ScannerCommand}"
                            VerticalAlignment="Bottom"
                            Height="48" Width="100"
                            Margin="10,0,0,0" />

                    <!-- Recherche par nom, référence ou code article -->
                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="3" Height="12"
                                    Background="{StaticResource PinceauOr}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Rechercher un article"
                                       Style="{StaticResource TexteEtiquette}"
                                       Margin="7,0,0,0" />
                        </StackPanel>

                        <TextBox Style="{StaticResource ChampScan}"
                                 Text="{Binding TermeRecherche, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SurToucheRecherche"
                                 ToolTip="Nom du produit, référence ou code article, puis Entrée" />
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Rechercher"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding RechercherCommand}"
                            VerticalAlignment="Bottom"
                            Height="48" Width="115"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- Catalogue : le caissier choisit à la souris, sans rien saisir -->
            <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="16"
                                    Background="{StaticResource PinceauOr}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Tout le rayon"
                                       Style="{StaticResource TexteSousTitre}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Scannez, recherchez, ou cliquez directement sur un article"
                                   Style="{StaticResource TexteAttenue}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Retour au rayon complet après une recherche -->
                    <Border Grid.Row="1"
                            Background="{StaticResource PinceauFondOr}"
                            BorderBrush="{StaticResource PinceauOr}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="4,0,4,10"
                            Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}}">
                        <Grid>
                            <TextBlock Style="{StaticResource TexteSecondaire}" VerticalAlignment="Center">
                                <Run Text="Résultats de la recherche :" />
                                <Run Text="{Binding ResultatsRecherche.Count, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="article(s)" />
                            </TextBlock>

                            <Button Content="Revoir tout le rayon"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding EffacerRechercheCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="12,4"
                                    MinHeight="28"
                                    FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Résultats d'une recherche, quand il y en a une -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}}">
                        <ItemsControl ItemsSource="{Binding ResultatsRecherche}"
                                      ItemTemplate="{StaticResource CarteArticle}"
                                      ItemsPanel="{StaticResource GrilleArticles}" />
                    </ScrollViewer>

                    <!-- Catalogue complet, affiché par défaut -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding ResultatsRecherche.Count, Converter={StaticResource NonVideVisibilite}, ConverterParameter=inverse}">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Catalogue}"
                                          ItemTemplate="{StaticResource CarteArticle}"
                                          ItemsPanel="{StaticResource GrilleArticles}" />
                        </ScrollViewer>

                        <TextBlock Text="Aucun article en stock. Ajoutez des quantités depuis l'écran Stock."
                                   Style="{StaticResource TexteAttenue}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding CatalogueVide, Converter={StaticResource BooleenVisibilite}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Panier -->
            <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Text="Panier" Style="{StaticResource TexteSousTitre}" />
                        <Button Content="Vider le panier"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding ViderPanierCommand}"
                                HorizontalAlignment="Right"
                                Padding="12,5"
                                MinHeight="30"
                                FontSize="12" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Panier}"
                              SelectedItem="{Binding LigneSelectionnee}"
                              Style="{StaticResource Tableau}"
                              IsReadOnly="False"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code article" Binding="{Binding Sku}"
                                                Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}"
                                                Width="*" IsReadOnly="True" />

                            <DataGridTemplateColumn Header="Quantité" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="−"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Width="28" MinHeight="26" Padding="0"
                                                    FontSize="14"
                                                    Command="{Binding DataContext.DiminuerQuantiteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <TextBlock Text="{Binding Quantite}"
                                                       Width="38"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />

                                            <Button Content="+"
                                                    Style="{StaticResource BoutonSecondaire}"
                                                    Width="28" MinHeight="26" Padding="0"
                                                    FontSize="14"
                                                    Command="{Binding DataContext.AugmenterQuantiteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Prix unitaire"
                                                Binding="{Binding PrixUnitaire, StringFormat={}{0:N2}}"
                                                Width="120" />

                            <DataGridTextColumn Header="Remise"
                                                Binding="{Binding Remise, StringFormat={}{0:N2}}"
                                                Width="110" />

                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total, Converter={StaticResource Montant}}"
                                                Width="140" IsReadOnly="True" />

                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Style="{StaticResource BoutonSecondaire}"
                                                Foreground="{StaticResource PinceauDanger}"
                                                Width="28" MinHeight="26" Padding="0"
                                                ToolTip="Retirer cet article du panier"
                                                Command="{Binding DataContext.RetirerLigneCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Encaissement ================= -->
        <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Encaissement" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                    <TextBlock Text="Client (facultatif)" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListe}"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding ClientSelectionne}"
                              DisplayMemberPath="NomComplet"
                              IsEditable="False"
                              Margin="0,0,0,14" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- Totaux -->
                    <Border Background="{StaticResource PinceauSurfaceAlterne}"
                            CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Articles" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding NombreArticles}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sous-total" Style="{StaticResource TexteSecondaire}" />
                                <TextBlock Text="{Binding SousTotal, Converter={StaticResource Montant}}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,8" Visibility="{Binding PeutAccorderRemise,
                                                                Converter={StaticResource BooleenVisibilite}}">
                                <TextBlock Text="Remise sur le ticket" Style="{StaticResource TexteSecondaire}"
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource ChampTexte}"
                                         Text="{Binding RemiseGlobale, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}"
                                         Width="110" MinHeight="30" Padding="7,4"
                                         HorizontalAlignment="Right"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <Separator Margin="0,4,0,10" />

                            <Grid>
                                <TextBlock Text="TOTAL" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{Binding Total, Converter={StaticResource Montant}}"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource PinceauPrincipal}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Règlement -->
                    <TextBlock Text="Mode de paiement" Style="{StaticResource TexteEtiquette}" />
                    <ComboBox Style="{StaticResource ChampListeEnum}"
                              ItemsSource="{Binding ModesPaiement}"
                              SelectedItem="{Binding ModePaiement}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Montant reçu" Style="{StaticResource TexteEtiquette}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ChampScan}"
                                 Text="{Binding MontantRecu, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 HorizontalContentAlignment="Right" />

                        <Button Grid.Column="1"
                                Content="Appoint"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding MontantExactCommand}"
                                Width="90" Height="48"
                                Margin="8,0,0,0"
                                ToolTip="Saisir automatiquement le montant exact" />
                    </Grid>

                    <Border Background="{StaticResource PinceauFondSucces}"
                            CornerRadius="6" Padding="12"
                            Visibility="{Binding MonnaieARendre, Converter={StaticResource NonVideVisibilite}}">
                        <Grid>
                            <TextBlock Text="Monnaie à rendre" FontWeight="SemiBold"
                                       Foreground="{StaticResource PinceauSucces}" />
                            <TextBlock Text="{Binding MonnaieARendre, Converter={StaticResource Montant}}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PinceauSucces}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding MessageStatut}"
                               Style="{StaticResource TexteAttenue}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"
                               Visibility="{Binding MessageStatut, Converter={StaticResource NonVideVisibilite}}" />

                    <Button Content="VALIDER LA VENTE"
                            Style="{StaticResource BoutonCaisse}"
                            Background="{StaticResource PinceauSucces}"
                            BorderBrush="{StaticResource PinceauSucces}"
                            Command="{Binding ValiderVenteCommand}"
                            IsEnabled="{Binding PanierNonVide}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
