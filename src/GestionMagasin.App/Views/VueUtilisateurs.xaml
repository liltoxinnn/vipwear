<UserControl x:Class="GestionMagasin.App.Views.VueUtilisateurs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TabControl Margin="20,16" Background="Transparent" BorderThickness="0">

        <!-- ============ Comptes ============ -->
        <TabItem Header="Comptes utilisateurs">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Comptes du magasin"
                                   Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Utilisateurs}"
                                  SelectedItem="{Binding UtilisateurSelectionne}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Identifiant" Binding="{Binding NomUtilisateur}" Width="150" />
                                <DataGridTextColumn Header="Nom complet" Binding="{Binding NomComplet}" Width="*" />
                                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="140" />
                                <DataGridTextColumn Header="Ventes" Binding="{Binding NombreVentes}" Width="75" />
                                <DataGridTextColumn Header="Dernière connexion"
                                                    Binding="{Binding DerniereConnexion, Converter={StaticResource Date}, ConverterParameter=heure}"
                                                    Width="160" />
                                <DataGridTemplateColumn Header="État" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Pastille}">
                                                        <Setter Property="Background" Value="{StaticResource PinceauFondSucces}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Actif}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource PinceauFondDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextePastille}">
                                                            <Setter Property="Text" Value="Actif" />
                                                            <Setter Property="Foreground" Value="{StaticResource PinceauSucces}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Actif}" Value="False">
                                                                    <Setter Property="Text" Value="Inactif" />
                                                                    <Setter Property="Foreground" Value="{StaticResource PinceauDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="Nouveau compte"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouveauCompteCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="Modifier"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding ModifierCompteCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="Activer / Désactiver"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding BasculerEtatCompteCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="Réinitialiser le mot de passe"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding ReinitialiserMotDePasseCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Formulaire de compte -->
                <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16">
                    <StackPanel Visibility="{Binding ModeEdition, Converter={StaticResource BooleenVisibilite}}">
                        <TextBlock Text="Fiche du compte" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,14" />

                        <TextBlock Text="Nom *" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Nom}" Margin="0,0,0,10" />

                        <TextBlock Text="Prénom *" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Prenom}" Margin="0,0,0,10" />

                        <TextBlock Text="Identifiant de connexion *" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding NomUtilisateur}" Margin="0,0,0,10" />

                        <TextBlock Text="Mot de passe" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding MotDePasse}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AideMotDePasse}"
                                   Style="{StaticResource TexteAttenue}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Rôle *" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding RoleAttribue}"
                                  DisplayMemberPath="Nom"
                                  Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Command="{Binding AnnulerEditionCommand}"
                                    Width="110" Margin="0,0,8,0" />

                            <Button Content="Enregistrer"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding EnregistrerCompteCommand}"
                                    Width="130" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ Rôles et permissions ============ -->
        <TabItem Header="Rôles et permissions">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Carte}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Rôles"
                                   Style="{StaticResource TexteSousTitre}" Margin="4,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding RoleSelectionne}"
                                  Style="{StaticResource Tableau}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rôle" Binding="{Binding Nom}" Width="*" />
                                <DataGridTextColumn Header="Comptes" Binding="{Binding NombreUtilisateurs}" Width="80" />
                                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions.Count}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Nouveau rôle"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding NouveauRoleCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="Supprimer"
                                    Style="{StaticResource BoutonDanger}"
                                    Command="{Binding SupprimerRoleCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{Binding RoleSelectionne.Nom}" Style="{StaticResource TexteSousTitre}" />
                            <TextBlock Text="{Binding RoleSelectionne.Description}"
                                       Style="{StaticResource TexteAttenue}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Permissions}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource TexteEtiquette}"
                                                           Margin="0,10,0,4" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource CaseACocher}"
                                                  IsChecked="{Binding Accordee}"
                                                  Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource TexteAttenue}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Content="Enregistrer les permissions"
                                Style="{StaticResource BoutonPrincipal}"
                                Command="{Binding EnregistrerPermissionsCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ Journal d'audit ============ -->
        <TabItem Header="Journal d'audit">
            <Border Style="{StaticResource Carte}" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Text="Historique des actions importantes"
                                   Style="{StaticResource TexteSousTitre}" />

                        <Button Content="Actualiser"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding RafraichirJournalCommand}"
                                HorizontalAlignment="Right"
                                Padding="12,5" MinHeight="30" FontSize="12" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding EntreesAudit}"
                              Style="{StaticResource Tableau}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateCreation, Converter={StaticResource Date}, ConverterParameter=heure}"
                                                Width="150" />
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur}" Width="180" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="170" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeEntite}" Width="130" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>

    </TabControl>
</UserControl>
