<Window x:Class="GestionMagasin.App.Views.FenetreConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestionMagasin.App.Views"
        Title="Connexion — Gestion Magasin"
        Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PinceauFond}">

    <Border Margin="26" Style="{StaticResource Carte}" Padding="30">
        <StackPanel VerticalAlignment="Center">

            <!-- Blason du magasin -->
            <Grid Width="112" Height="112" HorizontalAlignment="Center">

                <!-- Logo déposé par le magasin -->
                <Ellipse Visibility="{Binding BlasonDessine, Converter={StaticResource BooleenVisibilite}, ConverterParameter=inverse}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Logo}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Blason dessiné, employé à défaut de logo -->
                <Grid Visibility="{Binding BlasonDessine, Converter={StaticResource BooleenVisibilite}}">
                    <Ellipse Fill="{StaticResource PinceauPrincipal}" />
                    <Ellipse Stroke="{StaticResource PinceauOrPoli}" StrokeThickness="3" Margin="2" />
                    <Ellipse Stroke="{StaticResource PinceauOr}" StrokeThickness="1" Margin="9" Opacity="0.55" />

                    <Path Data="{Binding Source={x:Static views:Enseigne.Couronne}, Converter={StaticResource Icone}}"
                          Fill="{StaticResource PinceauOrPoli}"
                          Width="46" Height="46"
                          Stretch="Uniform"
                          Margin="0,-6,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

                    <TextBlock Text="VIP"
                               Foreground="{StaticResource PinceauOrClair}"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,20" />
                </Grid>
            </Grid>

            <TextBlock Text="{Binding NomMagasin}"
                       Style="{StaticResource TexteTitre}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,18,0,4" />

            <TextBlock Text="Logiciel de gestion du magasin"
                       Style="{StaticResource TexteSecondaire}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

            <!-- Identifiants -->
            <TextBlock Text="Identifiant" Style="{StaticResource TexteEtiquette}" />
            <TextBox x:Name="ChampIdentifiant"
                     Style="{StaticResource ChampTexte}"
                     Text="{Binding NomUtilisateur, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" />

            <TextBlock Text="Mot de passe" Style="{StaticResource TexteEtiquette}" />
            <PasswordBox x:Name="ChampMotDePasse"
                         Padding="9,7"
                         MinHeight="34"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource PinceauBordureForte}"
                         PasswordChanged="SurMotDePasseModifie"
                         KeyDown="SurToucheMotDePasse"
                         Margin="0,0,0,10" />

            <!-- Message d'erreur -->
            <Border Background="{StaticResource PinceauFondDanger}"
                    CornerRadius="5"
                    Padding="12,9"
                    Margin="0,0,0,14"
                    Visibility="{Binding MessageErreur, Converter={StaticResource NonVideVisibilite}}">
                <TextBlock Text="{Binding MessageErreur}"
                           Foreground="{StaticResource PinceauDanger}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <Button Content="Se connecter"
                    Style="{StaticResource BoutonCaisse}"
                    Command="{Binding SeConnecterCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding EstOccupe, Converter={StaticResource BooleenInverse}}"
                    Margin="0,6,0,10" />

            <TextBlock Text="Connexion en cours…"
                       Style="{StaticResource TexteAttenue}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Visibility="{Binding EstOccupe, Converter={StaticResource BooleenVisibilite}}" />

            <Button Content="Quitter"
                    Style="{StaticResource BoutonSecondaire}"
                    Command="{Binding QuitterCommand}" />

        </StackPanel>
    </Border>
</Window>
