<Window x:Class="GestionMagasin.App.Views.Dialogues.FenetreProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Height="640" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PinceauFond}">

    <Border Margin="18" Style="{StaticResource Carte}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Titre}" Style="{StaticResource TexteSousTitre}" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Référence *" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Reference}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Code article (SKU) *" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Sku}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nom du produit *" Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Nom}" Margin="0,0,0,12" />

                <TextBlock Text="Description" Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Description}"
                         AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Marque" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Marques}"
                                  SelectedItem="{Binding Marque}"
                                  DisplayMemberPath="Nom" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Collection" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Collections}"
                                  Text="{Binding Collection}"
                                  IsEditable="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Saison" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Saisons}"
                                  Text="{Binding Saison}"
                                  IsEditable="True" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource PinceauSurfaceAlterne}"
                        CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Tarification" Style="{StaticResource TexteEtiquette}" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prix d'achat (DA)" Style="{StaticResource TexteEtiquette}" />
                                <TextBox Style="{StaticResource ChampTexte}"
                                         Text="{Binding PrixAchat, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prix de vente (DA)" Style="{StaticResource TexteEtiquette}" />
                                <TextBox Style="{StaticResource ChampTexte}"
                                         Text="{Binding PrixVente, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Marge dégagée" Style="{StaticResource TexteSecondaire}" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{StaticResource PinceauSucces}">
                                <Run Text="{Binding Marge, Converter={StaticResource Montant}, Mode=OneWay}" />
                                <Run Text="  (" /><Run Text="{Binding TauxMarge, Mode=OneWay, StringFormat={}{0:N1}}" /><Run Text=" %)" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Les tailles et couleurs se définissent ensuite, dans les déclinaisons du produit."
                           Style="{StaticResource TexteAttenue}"
                           TextWrapping="Wrap" Margin="0,0,0,14" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AnnulerCommand}"
                            Width="120" IsCancel="True" Margin="0,0,10,0" />

                    <Button Content="Enregistrer"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding EnregistrerCommand}"
                            Width="140" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
