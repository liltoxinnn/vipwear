<Window x:Class="GestionMagasin.App.Views.Dialogues.FenetreSaisieTexte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="240" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PinceauFond}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="18" Style="{StaticResource Carte}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TexteMessage"
                       Style="{StaticResource TexteSecondaire}"
                       Margin="0,0,0,12" />

            <TextBox Grid.Row="1"
                     x:Name="ChampSaisie"
                     Style="{StaticResource ChampTexte}"
                     AcceptsReturn="False"
                     KeyDown="SurToucheEnfoncee" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annuler"
                        Style="{StaticResource BoutonSecondaire}"
                        Width="110"
                        IsCancel="True"
                        Click="SurAnnuler"
                        Margin="0,0,10,0" />

                <Button Content="Valider"
                        Style="{StaticResource BoutonPrincipal}"
                        Width="110"
                        IsDefault="True"
                        Click="SurValider" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
