<Window x:Class="GestionMagasin.App.Views.Dialogues.FenetreVariante"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PinceauFond}">

    <Border Margin="18" Style="{StaticResource Carte}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Titre}" Style="{StaticResource TexteSousTitre}" />
                <TextBlock Text="{Binding NomProduit}" Style="{StaticResource TexteAttenue}" Margin="0,4,0,16" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Couleur *" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Couleurs}"
                                  SelectedItem="{Binding Couleur}"
                                  DisplayMemberPath="Nom" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Taille *" Style="{StaticResource TexteEtiquette}" />
                        <ComboBox Style="{StaticResource ChampListe}"
                                  ItemsSource="{Binding Tailles}"
                                  SelectedItem="{Binding Taille}"
                                  DisplayMemberPath="Nom" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Code article (laisser vide pour le composer automatiquement)"
                           Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Sku}" Margin="0,0,0,12" />

                <TextBlock Text="Code-barres" Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampScan}" Text="{Binding CodeBarres}" Margin="0,0,0,4" />
                <TextBlock Text="Scannez l'article pour renseigner ce champ automatiquement."
                           Style="{StaticResource TexteAttenue}" Margin="0,0,0,12" />

                <Border Background="{StaticResource PinceauSurfaceAlterne}"
                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Prix spécifiques à cette déclinaison"
                                   Style="{StaticResource TexteEtiquette}" />
                        <TextBlock Text="Laissez vide pour appliquer les prix du produit."
                                   Style="{StaticResource TexteAttenue}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prix d'achat (DA)" Style="{StaticResource TexteEtiquette}" />
                                <TextBox Style="{StaticResource ChampTexte}" Text="{Binding PrixAchat}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prix de vente (DA)" Style="{StaticResource TexteEtiquette}" />
                                <TextBox Style="{StaticResource ChampTexte}" Text="{Binding PrixVente}"
                                         HorizontalContentAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seuil d'alerte" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding SeuilMinimum}"
                                 ToolTip="Quantité en dessous de laquelle l'article est signalé en stock faible" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Visibility="{Binding EstCreation, Converter={StaticResource BooleenVisibilite}}">
                        <TextBlock Text="Quantité initiale en stock" Style="{StaticResource TexteEtiquette}" />
                        <TextBox Style="{StaticResource ChampTexte}" Text="{Binding QuantiteInitiale}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AnnulerCommand}"
                            Width="120" IsCancel="True" Margin="0,0,10,0" />

                    <Button Content="Enregistrer"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding EnregistrerCommand}"
                            Width="140" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
