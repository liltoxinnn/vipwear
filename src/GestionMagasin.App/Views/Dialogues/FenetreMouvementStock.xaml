<Window x:Class="GestionMagasin.App.Views.Dialogues.FenetreMouvementStock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PinceauFond}">

    <!--
        La fenêtre est elle-même la confirmation : elle nomme l'article,
        montre le stock d'avant, celui d'après et l'écart entre les deux.
        Aucune boîte Windows ne vient se poser par-dessus pour redemander
        « êtes-vous sûr ? » — cela n'ajoutait aucune information, seulement
        un geste de plus et l'habitude de valider sans lire.
    -->
    <Border Margin="16" Style="{StaticResource Carte}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Bandeau : de quel article s'agit-il ============ -->
            <Border Grid.Row="0" Style="{StaticResource BandeauFenetre}">
                <StackPanel>
                    <TextBlock Text="{Binding Titre}"
                               Foreground="{StaticResource PinceauOrClair}"
                               FontSize="12"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Binding Designation}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Foreground="#9C968A" FontSize="11.5" Margin="0,3,0,0">
                        <Run Text="{Binding Sku, Mode=OneWay}" />
                        <Run Text="  •  en stock : " /><Run Text="{Binding StockActuel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============ Saisie ============ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18">
                <StackPanel>

                    <!-- Mouvement manuel : sens et type -->
                    <StackPanel Visibility="{Binding EstAjustement,
                                             Converter={StaticResource BooleenVisibilite},
                                             ConverterParameter=inverse}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sens du mouvement" Style="{StaticResource TexteEtiquette}" />
                                <ComboBox Style="{StaticResource ChampListe}"
                                          ItemsSource="{Binding Sens}"
                                          SelectedItem="{Binding SensChoisi}"
                                          DisplayMemberPath="Libelle" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Type de mouvement" Style="{StaticResource TexteEtiquette}" />
                                <ComboBox Style="{StaticResource ChampListeEnum}"
                                          ItemsSource="{Binding TypesMouvement}"
                                          SelectedItem="{Binding TypeMouvement}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nombre d'articles" Style="{StaticResource TexteEtiquette}" />
                    </StackPanel>

                    <!-- Ajustement d'inventaire : la quantité constatée -->
                    <TextBlock Text="Quantité réellement constatée en rayon"
                               Style="{StaticResource TexteEtiquette}"
                               Visibility="{Binding EstAjustement, Converter={StaticResource BooleenVisibilite}}" />

                    <!--
                        Un seul compteur pour les deux cas : moins, le nombre,
                        plus. Les deux boutons couvrent l'écart d'une ou deux
                        unités, le plus fréquent en réserve ; le champ reste
                        saisissable pour les autres.
                    -->
                    <Grid Margin="0,7,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="−"
                                Style="{StaticResource BoutonCompteur}"
                                Command="{Binding DiminuerCommand}"
                                ToolTip="Retirer un article" />

                        <Grid Grid.Column="2">
                            <TextBox x:Name="ChampQuantiteConstatee"
                                     Style="{StaticResource ChampNombre}"
                                     Text="{Binding QuantiteConstatee, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding EstAjustement,
                                                  Converter={StaticResource BooleenVisibilite}}" />

                            <TextBox x:Name="ChampQuantiteMouvement"
                                     Style="{StaticResource ChampNombre}"
                                     Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding EstAjustement,
                                                  Converter={StaticResource BooleenVisibilite},
                                                  ConverterParameter=inverse}" />
                        </Grid>

                        <Button Grid.Column="4"
                                Content="+"
                                Style="{StaticResource BoutonCompteur}"
                                Command="{Binding AugmenterCommand}"
                                ToolTip="Ajouter un article" />
                    </Grid>

                    <!-- ============ Ce que l'opération va faire ============ -->
                    <Border CornerRadius="12" Padding="16,13" Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource PinceauSurfaceAlterne}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PinceauBordure}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StockNegatif}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PinceauFondDanger}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PinceauDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Avant, après, et l'écart entre les deux -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StockActuel}"
                                               FontSize="20"
                                               Foreground="{StaticResource PinceauTexteSecondaire}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="→"
                                               FontSize="18"
                                               Foreground="{StaticResource PinceauTexteSecondaire}"
                                               Margin="12,0"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding StockApres}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinceauTexte}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Text="articles"
                                               Style="{StaticResource TexteAttenue}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource Pastille}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LibelleEcart}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextePastille}">
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="Foreground" Value="{StaticResource PinceauTexteSecondaire}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EcartPositif}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PinceauSucces}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EcartNegatif}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PinceauDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <TextBlock Text="Cette opération ferait passer le stock sous zéro : elle sera refusée."
                                       Foreground="{StaticResource PinceauDanger}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding StockNegatif, Converter={StaticResource BooleenVisibilite}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Motif, facultatif ============ -->
                    <TextBlock Text="Motif (facultatif)"
                               Style="{StaticResource TexteEtiquette}"
                               Margin="0,18,0,6" />

                    <ItemsControl ItemsSource="{Binding MotifsCourants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PuceMotif}"
                                        Content="{Binding}"
                                        Command="{Binding DataContext.ChoisirMotifCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Style="{StaticResource ChampTexte}"
                             Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             Margin="0,3,0,5" />

                    <TextBlock Style="{StaticResource TexteAttenue}"
                               Text="{Binding MentionMotifParDefaut}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Confirmation ============ -->
            <Border Grid.Row="2"
                    Background="{StaticResource PinceauSurfaceAlterne}"
                    BorderBrush="{StaticResource PinceauBordure}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Style="{StaticResource BoutonSecondaire}"
                            Command="{Binding AnnulerCommand}"
                            Width="120"
                            MinHeight="44"
                            IsCancel="True"
                            Margin="0,0,10,0" />

                    <Button Content="Confirmer"
                            Style="{StaticResource BoutonPrincipal}"
                            Command="{Binding ValiderCommand}"
                            Width="170"
                            MinHeight="44"
                            IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
