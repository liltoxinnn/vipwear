<Window x:Class="GestionMagasin.App.Views.Dialogues.FenetreMouvementStock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Height="560" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PinceauFond}">

    <Border Margin="18" Style="{StaticResource Carte}">
        <StackPanel>
            <TextBlock Text="{Binding Titre}" Style="{StaticResource TexteSousTitre}" />

            <Border Background="{StaticResource PinceauSurfaceAlterne}"
                    CornerRadius="6" Padding="12" Margin="0,12,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Designation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource TexteAttenue}" Margin="0,4,0,0">
                        <Run Text="Code article " /><Run Text="{Binding Sku, Mode=OneWay}" />
                        <Run Text=" • Stock actuel : " /><Run Text="{Binding StockActuel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Mouvement manuel -->
            <StackPanel Visibility="{Binding EstAjustement, Converter={StaticResource BooleenVisibilite}, ConverterParameter=inverse}">
                <TextBlock Text="Sens du mouvement" Style="{StaticResource TexteEtiquette}" />
                <ComboBox Style="{StaticResource ChampListe}"
                          ItemsSource="{Binding Sens}"
                          SelectedItem="{Binding SensChoisi}"
                          DisplayMemberPath="Libelle"
                          Margin="0,0,0,12" />

                <TextBlock Text="Type de mouvement" Style="{StaticResource TexteEtiquette}" />
                <ComboBox Style="{StaticResource ChampListeEnum}"
                          ItemsSource="{Binding TypesMouvement}"
                          SelectedItem="{Binding TypeMouvement}"
                          Margin="0,0,0,12" />

                <TextBlock Text="Quantité" Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampScan}"
                         Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalContentAlignment="Right"
                         Margin="0,0,0,12" />
            </StackPanel>

            <!-- Ajustement d'inventaire -->
            <StackPanel Visibility="{Binding EstAjustement, Converter={StaticResource BooleenVisibilite}}">
                <TextBlock Text="Quantité réellement constatée en rayon"
                           Style="{StaticResource TexteEtiquette}" />
                <TextBox Style="{StaticResource ChampScan}"
                         Text="{Binding QuantiteConstatee, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalContentAlignment="Right"
                         Margin="0,0,0,12" />
            </StackPanel>

            <TextBlock Text="Motif *" Style="{StaticResource TexteEtiquette}" />
            <TextBox Style="{StaticResource ChampTexte}" Text="{Binding Motif}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="Le motif figurera dans l'historique du stock."
                       Style="{StaticResource TexteAttenue}" Margin="0,0,0,14" />

            <Border CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PinceauFondInfo}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StockNegatif}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PinceauFondDanger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <TextBlock Text="Stock après l'opération" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StockApres}"
                                   FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Cette opération ferait passer le stock sous zéro : elle sera refusée."
                               Foreground="{StaticResource PinceauDanger}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding StockNegatif, Converter={StaticResource BooleenVisibilite}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Style="{StaticResource BoutonSecondaire}"
                        Command="{Binding AnnulerCommand}"
                        Width="120" IsCancel="True" Margin="0,0,10,0" />

                <Button Content="Valider"
                        Style="{StaticResource BoutonPrincipal}"
                        Command="{Binding ValiderCommand}"
                        Width="140" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
