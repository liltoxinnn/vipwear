<Window x:Class="GestionMagasin.App.Views.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Magasin"
        Height="820" Width="1400"
        MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PinceauFond}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Menu latéral ================= -->
        <Border Grid.Column="0" Background="{StaticResource PinceauPrincipal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Identité du magasin -->
                <Grid Grid.Row="0" Margin="16,20,16,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Même pastille que sur l'écran de connexion -->
                    <Border Grid.Column="0"
                            Background="#31548F"
                            BorderBrush="#5C82C4"
                            BorderThickness="1"
                            CornerRadius="9"
                            Width="38" Height="38"
                            VerticalAlignment="Top">
                        <TextBlock Text="GM"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomMagasin}"
                                   Foreground="White"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                        <TextBlock Text="Logiciel de gestion"
                                   Foreground="#9DB2D6"
                                   FontSize="10.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Entrées de navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OuvrirCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fond"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="4,0,0,0"
                                                    Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path x:Name="Dessin"
                                                          Grid.Column="0"
                                                          Data="{Binding Icone, Converter={StaticResource Icone}}"
                                                          Stroke="#AFC4E4"
                                                          StrokeThickness="1.5"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Width="19" Height="19"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          SnapsToDevicePixels="True" />

                                                    <TextBlock x:Name="Libelle"
                                                               Grid.Column="1"
                                                               Text="{Binding Libelle}"
                                                               Foreground="#DCE6F6"
                                                               FontSize="13.5"
                                                               Margin="13,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Raccourci}"
                                                               Foreground="#7C93BC"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#2A4779" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="#FFFFFF" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstActive}" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#31548F" />
                                                    <Setter TargetName="Fond" Property="BorderBrush" Value="#8FB6F5" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="#FFFFFF" />
                                                    <Setter TargetName="Dessin" Property="StrokeThickness" Value="1.8" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Utilisateur connecté -->
                <Border Grid.Row="2"
                        Background="{StaticResource PinceauPrincipalFonce}"
                        Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#4E70AC"
                                    CornerRadius="16"
                                    Width="32" Height="32">
                                <TextBlock Text="{Binding InitialesUtilisateur}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NomUtilisateur}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding RoleUtilisateur}"
                                           Foreground="#9DB2D6"
                                           FontSize="10.5" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Se déconnecter"
                                Command="{Binding SeDeconnecterCommand}"
                                Cursor="Hand"
                                Foreground="White"
                                Background="#3A5B96"
                                BorderBrush="#4E70AC"
                                BorderThickness="1"
                                FontSize="12"
                                Padding="10,7" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Zone de travail ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bandeau supérieur -->
            <Border Grid.Row="0"
                    Background="{StaticResource PinceauSurface}"
                    BorderBrush="{StaticResource PinceauBordure}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PageCourante.Titre}"
                                   Style="{StaticResource TexteTitre}" />
                        <TextBlock Text="{Binding PageCourante.SousTitre}"
                                   Style="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding PageCourante.SousTitre,
                                                Converter={StaticResource NonVideVisibilite}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateDuJour}"
                                   Style="{StaticResource TexteSecondaire}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <Button Content="Actualiser"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding RafraichirCommand}"
                                ToolTip="Recharger les données de l'écran (F5)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page affichée -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding PageCourante}" />

                <!-- Voile d'attente -->
                <Border Background="#66FFFFFF"
                        Visibility="{Binding PageCourante.EstOccupe,
                                     Converter={StaticResource BooleenVisibilite}}">
                    <Border Style="{StaticResource Carte}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="26,20">
                        <StackPanel>
                            <TextBlock Text="Traitement en cours…"
                                       Style="{StaticResource TexteSousTitre}"
                                       HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Width="190"
                                         Margin="0,12,0,0"
                                         Foreground="{StaticResource PinceauAccent}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
