<Window x:Class="GestionMagasin.App.Views.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestionMagasin.App.Views"
        Title="VIP MEN’S STORE"
        Height="820" Width="1400"
        MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PinceauFond}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Menu latéral ================= -->
        <Border Grid.Column="0" Background="{StaticResource PinceauPrincipal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Identité du magasin -->
                <Grid Grid.Row="0" Margin="16,20,16,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Même emblème que sur l'écran de connexion, en réduit -->
                    <ContentControl Grid.Column="0"
                                    Width="44" Height="44"
                                    VerticalAlignment="Top"
                                    Template="{StaticResource BlasonCompact}" />

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomMagasin}"
                                   Foreground="White"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                        <TextBlock Text="Logiciel de gestion"
                                   Foreground="#8A857A"
                                   FontSize="10.5"
                                   Margin="0,2,0,0" />

                        <!--
                            Version et date de compilation. C'est le seul
                            repère qui dise, sans chercher, si le poste
                            tourne bien sur la dernière livraison.
                        -->
                        <TextBlock Text="{Binding VersionLogiciel}"
                                   Foreground="#6E695E"
                                   FontSize="9.5"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Entrées de navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OuvrirCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fond"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="4,0,0,0"
                                                    Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path x:Name="Dessin"
                                                          Grid.Column="0"
                                                          Data="{Binding Icone, Converter={StaticResource Icone}}"
                                                          Stroke="#9C968A"
                                                          StrokeThickness="1.5"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Width="19" Height="19"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          SnapsToDevicePixels="True" />

                                                    <TextBlock x:Name="Libelle"
                                                               Grid.Column="1"
                                                               Text="{Binding Libelle}"
                                                               Foreground="#CFCABE"
                                                               FontSize="13.5"
                                                               Margin="13,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Raccourci}"
                                                               Foreground="#6E695E"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#1F1F1F" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="{StaticResource PinceauOrClair}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstActive}" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#1C1A14" />
                                                    <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource PinceauOr}" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Dessin" Property="StrokeThickness" Value="1.8" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--
                    Compte connecté. La déconnexion n'occupe plus une ligne
                    entière : elle tient dans son icône, à droite du nom, ce
                    qui laisse la place au rôle — l'information qu'un employé
                    doit pouvoir vérifier d'un coup d'œil avant de vendre.
                -->
                <Border Grid.Row="2"
                        Background="{StaticResource PinceauPrincipalFonce}"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Pastille aux initiales, cerclée d'or -->
                        <Grid Grid.Column="0" Width="36" Height="36">
                            <Ellipse Fill="#1C1A14" />
                            <Ellipse Stroke="{StaticResource PinceauOrPoli}" StrokeThickness="1.4" />
                            <TextBlock Text="{Binding InitialesUtilisateur}"
                                       Foreground="{StaticResource PinceauOrClair}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NomUtilisateur}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Path Data="{Binding Source={x:Static views:IconesMenu.Role},
                                             Converter={StaticResource Icone}}"
                                      Fill="{StaticResource PinceauOr}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />

                                <TextBlock Text="{Binding RoleUtilisateur}"
                                           Foreground="{StaticResource PinceauOrClair}"
                                           FontSize="10.5"
                                           Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Déconnexion : l'icône seule, et son infobulle -->
                        <Button Grid.Column="2"
                                Command="{Binding SeDeconnecterCommand}"
                                Cursor="Hand"
                                Width="34" Height="34"
                                ToolTip="Se déconnecter"
                                AutomationProperties.Name="Se déconnecter">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Fond"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Path x:Name="Dessin"
                                              Data="{Binding Source={x:Static views:IconesMenu.Deconnexion},
                                                     Converter={StaticResource Icone}}"
                                              Stroke="#9C968A"
                                              StrokeThickness="1.6"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Width="17" Height="17"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fond" Property="Background" Value="#241F12" />
                                            <Setter TargetName="Fond" Property="BorderBrush"
                                                    Value="{StaticResource PinceauOrFonce}" />
                                            <Setter TargetName="Dessin" Property="Stroke"
                                                    Value="{StaticResource PinceauOrClair}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Fond" Property="Background" Value="#332B18" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Zone de travail ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bandeau supérieur -->
            <Border Grid.Row="0"
                    Background="{StaticResource PinceauSurface}"
                    BorderBrush="{StaticResource PinceauOr}"
                    BorderThickness="0,0,0,2"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PageCourante.Titre}"
                                   Style="{StaticResource TexteTitre}" />
                        <TextBlock Text="{Binding PageCourante.SousTitre}"
                                   Style="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding PageCourante.SousTitre,
                                                Converter={StaticResource NonVideVisibilite}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PinceauFondOr}"
                                BorderBrush="{StaticResource PinceauOr}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding PageCourante.EstOccupe,
                                             Converter={StaticResource BooleenVisibilite}}">
                            <TextBlock Text="Traitement en cours…"
                                       Foreground="{StaticResource PinceauOrFonce}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="{Binding DateDuJour}"
                                   Style="{StaticResource TexteSecondaire}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <!--
                            Plein écran. Sur le poste de caisse, la barre des
                            tâches et le cadre de la fenêtre ne servent à rien
                            et prennent la place de deux rangées de vignettes.

                            L'état est tenu par la fenêtre elle-même et non
                            par la vue-modèle : il ne concerne que
                            l'affichage, et survivrait mal à un changement
                            d'écran.
                        -->
                        <ToggleButton x:Name="BasculePleinEcran"
                                      IsChecked="{Binding PleinEcran,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                      Cursor="Hand"
                                      Width="44" Height="38"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Plein écran">
                            <ToggleButton.ToolTip>
                                <TextBlock Text="Plein écran (Ctrl+F11) — Échap pour revenir" />
                            </ToggleButton.ToolTip>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Fond"
                                            Background="{StaticResource PinceauSurface}"
                                            BorderBrush="{StaticResource PinceauBordureForte}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <!--
                                            Deux tracés superposés plutôt
                                            qu'un tracé changé par le
                                            déclencheur : une liaison posée
                                            dans la valeur d'un Setter se
                                            résout dans le contexte du modèle
                                            et non dans celui de la fenêtre.
                                        -->
                                        <Grid>
                                            <Path x:Name="Ouvrir"
                                                  Data="{Binding Source={x:Static views:IconesMenu.PleinEcran},
                                                         Converter={StaticResource Icone}}"
                                                  Stroke="{StaticResource PinceauTexteSecondaire}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                            <Path x:Name="Quitter"
                                                  Data="{Binding Source={x:Static views:IconesMenu.QuitterPleinEcran},
                                                         Converter={StaticResource Icone}}"
                                                  Stroke="{StaticResource PinceauOrFonce}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Ouvrir" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Quitter" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Fond" Property="Background"
                                                    Value="{StaticResource PinceauFondOr}" />
                                            <Setter TargetName="Fond" Property="BorderBrush"
                                                    Value="{StaticResource PinceauOr}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fond" Property="BorderBrush"
                                                    Value="{StaticResource PinceauOr}" />
                                            <Setter TargetName="Ouvrir" Property="Stroke"
                                                    Value="{StaticResource PinceauOrFonce}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button Content="Actualiser"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding RafraichirCommand}"
                                ToolTip="Recharger les données de l'écran (F5)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Page affichée. L'attente est signalée dans le bandeau supérieur
                et non par un voile recouvrant la page : un voile fait
                remesurer tout l'écran à chaque changement d'état, ce qui est
                coûteux et expose la mise en page à des enchaînements
                instables au pire moment — pendant un encaissement.
            -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding PageCourante}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
