<Window x:Class="GestionMagasin.App.Views.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestionMagasin.App.Views"
        Title="Gestion Magasin"
        Height="820" Width="1400"
        MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PinceauFond}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Menu latéral ================= -->
        <Border Grid.Column="0" Background="{StaticResource PinceauPrincipal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Identité du magasin -->
                <Grid Grid.Row="0" Margin="16,20,16,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Même blason que sur l'écran de connexion -->
                    <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Top">
                        <Ellipse Visibility="{Binding BlasonDessine, Converter={StaticResource BooleenVisibilite}, ConverterParameter=inverse}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Logo}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid Visibility="{Binding BlasonDessine, Converter={StaticResource BooleenVisibilite}}">
                            <Ellipse Fill="#0A0A0A" />
                            <Ellipse Stroke="{StaticResource PinceauOrPoli}" StrokeThickness="1.6" Margin="1" />
                            <Path Data="{Binding Source={x:Static views:Enseigne.Couronne}, Converter={StaticResource Icone}}"
                                  Fill="{StaticResource PinceauOrPoli}"
                                  Width="21" Height="21"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomMagasin}"
                                   Foreground="White"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                        <TextBlock Text="Logiciel de gestion"
                                   Foreground="#8A857A"
                                   FontSize="10.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Entrées de navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OuvrirCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fond"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="4,0,0,0"
                                                    Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Path x:Name="Dessin"
                                                          Grid.Column="0"
                                                          Data="{Binding Icone, Converter={StaticResource Icone}}"
                                                          Stroke="#9C968A"
                                                          StrokeThickness="1.5"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Width="19" Height="19"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          SnapsToDevicePixels="True" />

                                                    <TextBlock x:Name="Libelle"
                                                               Grid.Column="1"
                                                               Text="{Binding Libelle}"
                                                               Foreground="#CFCABE"
                                                               FontSize="13.5"
                                                               Margin="13,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Raccourci}"
                                                               Foreground="#6E695E"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#1F1F1F" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="{StaticResource PinceauOrClair}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstActive}" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="#1C1A14" />
                                                    <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource PinceauOr}" />
                                                    <Setter TargetName="Dessin" Property="Stroke" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Dessin" Property="StrokeThickness" Value="1.8" />
                                                    <Setter TargetName="Libelle" Property="Foreground" Value="{StaticResource PinceauOrClair}" />
                                                    <Setter TargetName="Libelle" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Utilisateur connecté -->
                <Border Grid.Row="2"
                        Background="{StaticResource PinceauPrincipalFonce}"
                        Padding="16,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource PinceauOrFonce}"
                                    CornerRadius="16"
                                    Width="32" Height="32">
                                <TextBlock Text="{Binding InitialesUtilisateur}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NomUtilisateur}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <Path Data="{Binding Source={x:Static views:IconesMenu.Role}, Converter={StaticResource Icone}}"
                                          Fill="{StaticResource PinceauOr}"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding RoleUtilisateur}"
                                               Foreground="{StaticResource PinceauOrClair}"
                                               FontSize="10.5"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding SeDeconnecterCommand}"
                                Cursor="Hand"
                                Foreground="{StaticResource PinceauOrClair}"
                                Background="#1F1D17"
                                BorderBrush="{StaticResource PinceauOrFonce}"
                                BorderThickness="1"
                                FontSize="12"
                                Padding="10,7">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{Binding Source={x:Static views:IconesMenu.Deconnexion}, Converter={StaticResource Icone}}"
                                      Stroke="{StaticResource PinceauOrClair}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />

                                <TextBlock Text="Se déconnecter"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Zone de travail ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bandeau supérieur -->
            <Border Grid.Row="0"
                    Background="{StaticResource PinceauSurface}"
                    BorderBrush="{StaticResource PinceauOr}"
                    BorderThickness="0,0,0,2"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PageCourante.Titre}"
                                   Style="{StaticResource TexteTitre}" />
                        <TextBlock Text="{Binding PageCourante.SousTitre}"
                                   Style="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding PageCourante.SousTitre,
                                                Converter={StaticResource NonVideVisibilite}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateDuJour}"
                                   Style="{StaticResource TexteSecondaire}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <Button Content="Actualiser"
                                Style="{StaticResource BoutonSecondaire}"
                                Command="{Binding RafraichirCommand}"
                                ToolTip="Recharger les données de l'écran (F5)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page affichée -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding PageCourante}" />

                <!-- Voile d'attente -->
                <Border Background="#66FFFFFF"
                        Visibility="{Binding PageCourante.EstOccupe,
                                     Converter={StaticResource BooleenVisibilite}}">
                    <Border Style="{StaticResource Carte}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="26,20">
                        <StackPanel>
                            <TextBlock Text="Traitement en cours…"
                                       Style="{StaticResource TexteSousTitre}"
                                       HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="4"
                                         Width="190"
                                         Margin="0,12,0,0"
                                         Foreground="{StaticResource PinceauAccent}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
