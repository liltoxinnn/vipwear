<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618;CS8625</WarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>GestionMagasin</Company>
    <Product>Gestion Magasin de Vêtements</Product>
    <Version>1.0.0</Version>
    <!--
      Permet de compiler les projets ciblant Windows (WPF) depuis un poste
      Linux/macOS d'intégration continue. Sans effet lors d'une compilation
      sous Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
